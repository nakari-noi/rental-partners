---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cookies from '../components/Cookies.astro';
import { site as config } from '../site.config';
import { langOf, counterpart, t } from '../i18n';

interface Faq { q: string; a: string }
interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  /** Cesta k náhľadovému obrázku (1200×630); predvolene og.jpg, pre angličtinu og-en.jpg */
  ogImage?: string;
  /** Stránky, ktoré Google nemá indexovať (404) */
  noindex?: boolean;
  /** Otázky a odpovede → FAQPage štruktúrované dáta */
  faq?: Faq[];
  /** Názov v omrvinkovej navigácii (predvolene title), alebo celá cesta pri hlbších stránkach (blog) */
  breadcrumb?: string | Crumb[];
  /** Článok blogu: BlogPosting v štruktúrovaných dátach a og:type article */
  article?: { headline: string; datePublished: string; dateModified?: string };
}
const { title, description, ogImage, noindex = false, faq, breadcrumb, article } = Astro.props;

const site = Astro.site ?? new URL('https://www.rentalpartners.sk');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = langOf(path);
const s = t[lang];
const isHome = path === s.home;
const canonical = new URL(path, site).href;
const fullTitle = `${title} · Rental Partners`;
const ogImageUrl = new URL(ogImage ?? (lang === 'en' ? '/og-en.jpg' : '/og.jpg'), site).href;

// Jazykové verzie: slovenčina je predvolená (x-default). Kde druhá verzia nie je (blog), uvádza sa len vlastný jazyk.
const other = counterpart(path);
const skHref = lang === 'sk' ? canonical : other ? new URL(other, site).href : null;
const enHref = lang === 'en' ? canonical : other ? new URL(other, site).href : null;

// Štruktúrované dáta (schema.org) — firma, web, stránka, omrvinky, prípadne FAQ a článok
const firmaId = `${site.href}#firma`;
const webId = `${site.href}#web`;
const pricingUrl = new URL(lang === 'en' ? '/en/pricing' : '/cennik', site).href;
const firma = {
  '@type': ['LocalBusiness', 'Organization'],
  '@id': firmaId,
  name: 'Rental Partners',
  legalName: 'Rental Partners s. r. o.',
  url: site.href,
  logo: new URL('/img/logo-znak.svg', site).href,
  image: ogImageUrl,
  description: s.ld.description,
  telephone: '+421903989040',
  email: 'rentalpartners2026@gmail.com',
  address: { '@type': 'PostalAddress', streetAddress: 'Námestie 1. mája 8062/11', addressLocality: 'Bratislava', postalCode: '811 06', addressCountry: 'SK' },
  geo: { '@type': 'GeoCoordinates', latitude: 48.1493, longitude: 17.1116 },
  areaServed: { '@type': 'City', name: 'Bratislava' },
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'IČO', value: '57632499' },
    { '@type': 'PropertyValue', propertyID: 'DIČ', value: '2122860663' },
  ],
  sameAs: ['https://sk.airbnb.com/users/show/515063940'],
  knowsLanguage: ['sk', 'cs', 'en'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: s.ld.catalog,
    itemListElement: [
      { '@type': 'Offer', name: s.ld.offerA, description: s.ld.offerADesc, url: pricingUrl, priceSpecification: { '@type': 'UnitPriceSpecification', price: '10', priceCurrency: 'EUR', unitText: s.ld.unit } },
      { '@type': 'Offer', name: s.ld.offerB, description: s.ld.offerBDesc, url: pricingUrl },
    ],
  },
};
const web = { '@type': 'WebSite', '@id': webId, url: site.href, name: 'Rental Partners', inLanguage: lang, publisher: { '@id': firmaId } };
const stranka = { '@type': 'WebPage', '@id': canonical, url: canonical, name: fullTitle, description, inLanguage: lang, isPartOf: { '@id': webId }, about: { '@id': firmaId }, primaryImageOfPage: ogImageUrl };
const cesta: Crumb[] = Array.isArray(breadcrumb) ? breadcrumb : [{ name: breadcrumb ?? title, href: path }];
const omrvinky = isHome ? null : {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.breadcrumbHome, item: new URL(s.home, site).href },
    ...cesta.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: new URL(c.href, site).href })),
  ],
};
const faqLd = faq?.length ? { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const clanok = article ? { '@type': 'BlogPosting', '@id': canonical + '#clanok', headline: article.headline, description, url: canonical, mainEntityOfPage: { '@id': canonical }, datePublished: article.datePublished, dateModified: article.dateModified ?? article.datePublished, inLanguage: lang, image: ogImageUrl, author: { '@id': firmaId }, publisher: { '@id': firmaId }, isPartOf: { '@id': webId } } : null;
const ld = { '@context': 'https://schema.org', '@graph': [firma, web, stranka, omrvinky, faqLd, clanok].filter(Boolean) };
// Vercel Web Analytics (bez cookies). Značka sa vkladá ako hotový HTML text: Astro inak <script> v podmienke vynechá.
const insightsTag = config.vercelAnalytics ? '<script defer src="/_vercel/insights/script.js"><' + '/script>' : '';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {skHref && <link rel="alternate" hreflang="sk" href={skHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    <link rel="alternate" hreflang="x-default" href={skHref ?? canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/img/logo-znak.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6efe4" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    {article && <meta property="article:modified_time" content={article.dateModified ?? article.datePublished} />}
    <meta property="og:site_name" content="Rental Partners" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'sk_SK'} />
    {other && <meta property="og:locale:alternate" content={lang === 'en' ? 'sk_SK' : 'en_US'} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={s.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#obsah" class="skip-link">{s.skip}</a>
    <Nav />
    <main id="obsah" class="flex-1"><slot /></main>
    <Footer />
    <Cookies />
    <Fragment set:html={insightsTag} />
  </body>
</html>
