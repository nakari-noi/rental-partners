---
interface Props { light?: boolean; class?: string }
const { light = false, class: cls = '' } = Astro.props;
---
<li class:list={['flex items-start gap-2.5 text-[15px] leading-[1.5]', light ? 'text-bg' : 'text-ink', cls]}>
  <svg class="shrink-0 mt-[3px]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={light ? '#8fb08a' : '#6e8b6a'} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
  <span><slot /></span>
</li>
