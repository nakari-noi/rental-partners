---
import Logo from './Logo.astro';
import { langOf, counterpart, t } from '../i18n';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = langOf(path);
const s = t[lang];
// Podstránky (napr. /blog/clanok) zvýrazňujú svoju sekciu v menu
const active = (href: string) => path === href || path.startsWith(href + '/');
const phone = { href: 'tel:+421903989040', label: s.phoneLabel, full: '+421 903 989 040' };
// Prepínač jazyka vedie na tú istú stránku v druhom jazyku; kde neexistuje (blog), na domov druhého jazyka
const switchHref = counterpart(path) ?? (lang === 'sk' ? '/en' : '/');
const otherLang = lang === 'sk' ? 'en' : 'sk';
const phoneIcon = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.8 2z';
---
<header class="wrap relative flex items-center justify-between gap-4 py-5 md:py-6">
  <a href={s.home} aria-label={s.homeAria} class="shrink-0"><Logo class="h-10 md:h-[46px] w-auto block" /></a>
  <nav class="hidden lg:flex items-center gap-7 text-[15px] font-semibold text-ink-soft" aria-label={s.mainNav}>
    {s.nav.map((l) => (
      <a href={l.href} class:list={['hover:text-ink transition-colors py-2 border-b-2', active(l.href) ? 'text-ink border-accent' : 'border-transparent']} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <div class="flex items-center gap-2 md:gap-3">
    <!-- Prepínač jazyka: na desktope v hlavičke, na mobile v menu -->
    <a href={switchHref} hreflang={otherLang} lang={otherLang} class="hidden lg:inline-flex items-center justify-center min-h-11 px-3.5 rounded-full text-[13px] font-bold tracking-[0.06em] text-ink-soft border border-sand hover:text-ink hover:border-ink-soft transition-colors" aria-label={s.switchAria}>{s.switchLabel}</a>
    <!-- Druhý kanál: telefón (6. 9. — namiesto duplikátu „Chcem odhad výnosu“) -->
    <a href={phone.href} class="btn-dark hidden md:inline-flex !pl-3.5 gap-2.5" aria-label={`${s.callTomasAria} ${phone.full}`}>
      <span class="w-[26px] h-[26px] rounded-full bg-bg/15 inline-flex items-center justify-center shrink-0"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg></span>
      {s.callTomas} · {phone.label}
    </a>
    <a href={phone.href} class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-full bg-ink text-bg" aria-label={`${s.call} · ${phone.full}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg>
    </a>
    <button type="button" class="lg:hidden inline-flex items-center justify-center min-w-11 min-h-11 -mr-2 rounded-full" aria-label={s.menuOpen} aria-expanded="false" aria-controls="mobilne-menu" data-menu-toggle data-label-open={s.menuOpen} data-label-close={s.menuClose}>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path data-icon-open d="M4 7h16M4 12h16M4 17h16"></path><path data-icon-close class="hidden" d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>
  <div id="mobilne-menu" class="lg:hidden hidden absolute right-5 md:right-10 top-[calc(100%-8px)] z-30 w-[264px]" data-menu>
    <nav class="flex flex-col gap-0.5 bg-surface rounded-[var(--radius-card)] p-2 border border-sand shadow-[var(--shadow-float)]" aria-label={s.mobileNav}>
      {s.nav.map((l) => (
        <a href={l.href} class:list={['px-3.5 py-2.5 rounded-xl text-[15px] font-semibold min-h-11 flex items-center', active(l.href) ? 'bg-sand text-ink' : 'text-ink-soft']} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href={switchHref} hreflang={otherLang} lang={otherLang} class="px-3.5 py-2.5 rounded-xl text-[15px] font-semibold min-h-11 flex items-center gap-2 text-ink-soft" aria-label={s.switchAria}><span class="text-[11px] font-extrabold tracking-[0.08em] px-1.5 py-0.5 rounded bg-sand text-ink">{s.switchLabel}</span>{s.switchMenu}</a>
      <a href={phone.href} class="px-3.5 py-2.5 rounded-xl text-[15px] font-semibold min-h-11 flex items-center gap-2 text-ink border-t border-sand mt-1 pt-3"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg>{s.call} · {phone.full}</a>
      <a href={s.contact} class="btn-primary !py-3 !px-5 !text-sm mt-1.5">{s.cta}</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const iconOpen = btn?.querySelector('[data-icon-open]');
  const iconClose = btn?.querySelector('[data-icon-close]');
  function setMenu(open: boolean) {
    if (!btn || !menu) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) || '');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }
  btn?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? false));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu || menu.classList.contains('hidden')) return;
    setMenu(false);
    btn?.focus();
  });
  document.addEventListener('click', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;
    const t = e.target as Node;
    if (!menu.contains(t) && !btn?.contains(t)) setMenu(false);
  });
</script>
