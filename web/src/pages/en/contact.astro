---
import Base from '../../layouts/Base.astro';
// The form posts to Web3Forms (no backend). Public key of the rentalpartners2026@gmail.com account.
// Field names stay Slovak on purpose so the e-mail to Tomáš looks the same for both languages.
const FORM_KEY = '047840b6-c6cd-46ef-b8c8-a73fb9cac26c';
const phoneIcon = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2.2z';
---
<Base title="Contact & Free Estimate for Your Flat" breadcrumb="Contact" description="Tell us about your flat in Bratislava. We meet you at the flat and prepare an income estimate, free and without obligation. Tel. +421 903 989 040.">
  <section class="wrap pt-10 pb-6 lg:pt-14">
    <span class="chip">Contact</span>
    <h1 class="mt-5 text-[38px] md:text-[52px] leading-[1.08] font-bold tracking-[-0.02em] max-w-[820px] text-pretty">Let’s talk about your flat</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft max-w-[640px]">Send us a few details about the flat. We get back to you as soon as possible and arrange a meeting at the flat. The estimate is free and without obligation.</p>
  </section>

  <section class="wrap grid lg:grid-cols-[1.25fr_0.75fr] gap-8 lg:gap-10 pt-4 pb-16 items-start">
    <div class="flex flex-col gap-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-5 py-4 sm:px-6 bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-float)]">
        <div class="flex items-center gap-3.5">
          <span class="w-12 h-12 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
          <p class="text-[15px] leading-snug text-ink-soft"><b class="text-ink">We reply as soon as we can.</b><br />The estimate is free and without obligation. The form takes a minute.</p>
        </div>
        <a href="tel:+421903989040" class="btn-dark !text-[15px] !py-3 gap-2.5 whitespace-nowrap self-start sm:self-auto"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg>Call · +421 903 989 040</a>
      </div>

      <form action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-5 p-6 md:p-9 bg-surface rounded-[var(--radius-block)]" id="dopyt" novalidate>
        <input type="hidden" name="access_key" value={FORM_KEY} />
        <input type="hidden" name="subject" value="Nový dopyt z rentalpartners.sk (EN)" />
        <input type="hidden" name="from_name" value="Web Rental Partners (EN)" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <p class="form-section">1 · About the flat</p>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>Where is the flat (district) <span class="text-accent" aria-hidden="true">*</span></span>
            <input class="field" type="text" name="lokalita" placeholder="e.g. Ružinov" required autocomplete="address-level2" data-msg="Enter the district, e.g. Ružinov or Old Town." />
            <span class="form-error" data-error hidden></span>
          </label>
          <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>Size of the flat <span class="text-accent" aria-hidden="true">*</span></span>
            <select class="field" name="velkost" required data-msg="Select the size of the flat."><option value="">Select</option><option>Studio / 1-room</option><option>2-room</option><option>3-room</option><option>4-room or larger</option></select>
            <span class="form-error" data-error hidden></span>
          </label>
        </div>
        <fieldset class="flex flex-col gap-2.5">
          <legend class="text-[13px] font-bold text-ink-soft mb-2.5">The flat is currently</legend>
          <div class="flex flex-wrap gap-2.5">
            <label class="pill relative"><input type="radio" name="stav" value="Empty" />Empty</label>
            <label class="pill relative"><input type="radio" name="stav" value="Let long-term" />Let long-term</label>
            <label class="pill relative"><input type="radio" name="stav" value="Already on Airbnb / Booking" />Already on Airbnb / Booking</label>
          </div>
        </fieldset>
        <fieldset class="flex flex-col gap-2.5">
          <legend class="text-[13px] font-bold text-ink-soft mb-2.5">I am interested in</legend>
          <div class="flex flex-wrap gap-2.5">
            <label class="pill relative"><input type="radio" name="zaujem" value="Management · 10 %" />Management · 10 %</label>
            <label class="pill relative"><input type="radio" name="zaujem" value="Guaranteed rent" />Guaranteed rent</label>
            <label class="pill relative"><input type="radio" name="zaujem" value="Not sure, advise me" checked />Not sure, advise me</label>
          </div>
        </fieldset>

        <p class="form-section mt-1">2 · How to reach you</p>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>Full name <span class="text-accent" aria-hidden="true">*</span></span>
            <input class="field" type="text" name="meno" required autocomplete="name" data-msg="Tell us how to address you." />
            <span class="form-error" data-error hidden></span>
          </label>
          <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>Phone <span class="text-accent" aria-hidden="true">*</span></span>
            <input class="field" type="tel" name="telefon" required autocomplete="tel" inputmode="tel" placeholder="+421 9xx xxx xxx" pattern="[\+0-9 \(\)\/\.\-]{9,20}" data-msg="This does not look like a phone number. Enter it as +421 903 123 456, we will call it." />
            <span class="text-[12px] font-normal text-ink-soft">We will call this number.</span>
            <span class="form-error" data-error hidden></span>
          </label>
        </div>
        <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>E-mail <span class="text-accent" aria-hidden="true">*</span></span>
          <input class="field" type="email" name="email" required autocomplete="email" data-msg="The e-mail is missing the part after @, e.g. name@gmail.com." />
          <span class="form-error" data-error hidden></span>
        </label>
        <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft">What would you like to know (optional)<textarea class="field" name="sprava"></textarea></label>
        <label class="flex items-start gap-3 text-[13px] leading-relaxed text-ink-soft">
          <input type="checkbox" name="suhlas" required class="mt-0.5 w-6 h-6 shrink-0 accent-[#c9694a]" data-msg="We cannot reply without your consent, please tick the box." />
          <span>I agree to the processing of my data for the purpose of replying to my enquiry. <a href="/en/privacy" class="underline">Privacy policy</a><span class="form-error block" data-error hidden></span></span>
        </label>
        <button type="submit" class="btn-primary text-base py-[18px]">Get a free estimate</button>
        <p class="text-center text-[12px] text-ink-soft"><span class="text-accent">*</span> required · we will not send you anything without your consent</p>
      </form>

      <!-- State: success -->
      <div class="hidden flex-col gap-4 p-6 md:p-8 bg-sage-soft rounded-[var(--radius-block)]" data-state="ok" role="status" aria-live="polite" tabindex="-1">
        <span class="w-12 h-12 rounded-full bg-sage text-white flex items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg></span>
        <h2 class="display text-2xl font-bold">Thank you, we have received your enquiry.</h2>
        <p class="text-[15px] leading-relaxed">We will get back to you on <b data-ok-phone>your number</b> as soon as possible. If another time suits you better, let us know at <a href="mailto:rentalpartners2026@gmail.com" class="underline">rentalpartners2026@gmail.com</a>.</p>
        <a href="/en/results" class="link-inline !text-accent-deep">Meanwhile: see the flats we look after →</a>
      </div>

      <!-- State: error -->
      <div class="hidden flex-col gap-4 p-6 md:p-8 bg-sand rounded-[var(--radius-block)]" data-state="err" role="alert" tabindex="-1">
        <span class="w-12 h-12 rounded-full bg-accent-deep text-white flex items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 8v5M12 16.5v.5"></path></svg></span>
        <h2 class="display text-2xl font-bold">Sending failed.</h2>
        <p class="text-[15px] leading-relaxed">Your details are still in the form. Try again in a moment, or call us directly:</p>
        <a href="tel:+421903989040" class="btn-dark justify-center gap-2.5"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg>Tomáš · +421 903 989 040</a>
        <a href="tel:+421944945045" class="inline-flex items-center justify-center py-3 px-5 bg-surface rounded-full font-bold text-[15px]">Amanda · +421 944 945 045</a>
        <p class="text-sm text-center">or <a href="mailto:rentalpartners2026@gmail.com" class="font-bold text-accent-deep underline">rentalpartners2026@gmail.com</a></p>
      </div>
    </div>

    <div class="flex flex-col gap-5">
      <div class="flex flex-col gap-4 p-7 bg-surface rounded-[var(--radius-block)]">
        <h2 class="text-xl font-semibold">Prefer to talk directly?</h2>
        <a href="tel:+421903989040" class="flex items-center gap-3 text-[15px] min-h-11"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg></span><span>Tomáš · +421 903 989 040</span></a>
        <a href="tel:+421944945045" class="flex items-center gap-3 text-[15px] min-h-11"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg></span><span>Amanda · +421 944 945 045</span></a>
        <a href="mailto:rentalpartners2026@gmail.com" class="flex items-center gap-3 text-[15px] min-h-11"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span><span>rentalpartners2026@gmail.com</span></a>
        <div class="flex items-center gap-3 text-[15px]"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span><span>Námestie 1. mája 8062/11, 811 06 Bratislava – Staré Mesto, Slovakia</span></div>
      </div>
      <div class="flex flex-col gap-4 p-7 bg-sand rounded-[var(--radius-block)]">
        <h2 class="text-xl font-semibold">What happens next</h2>
        <ol class="flex flex-col gap-3 text-[15px] leading-relaxed">
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">01</b>We get in touch and agree a date.</li>
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">02</b>We meet at the flat and look at the location and condition.</li>
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">03</b>You receive an income estimate and a draft contract. The decision is yours.</li>
        </ol>
      </div>
      <a href="https://www.openstreetmap.org/?mlat=48.1493&mlon=17.1116#map=17/48.1493/17.1116" target="_blank" rel="noopener" class="block rounded-[var(--radius-block)] overflow-hidden h-[240px]" aria-label="Open map, Námestie 1. mája, Bratislava">
        <img src="/img/mapa-stare-mesto.webp" alt="Map of the Old Town with Námestie 1. mája marked" class="w-full h-full object-cover" width="760" height="471" loading="lazy" />
      </a>
      <p class="text-[12px] text-ink-soft -mt-2">Map © OpenStreetMap contributors · <a href="https://www.openstreetmap.org/?mlat=48.1493&mlon=17.1116#map=17/48.1493/17.1116" target="_blank" rel="noopener" class="underline inline-flex items-center min-h-11">Open a larger map</a></p>
    </div>
  </section>

  <script>
    const form = document.getElementById('dopyt') as HTMLFormElement | null;
    const okBox = document.querySelector<HTMLElement>('[data-state="ok"]');
    const errBox = document.querySelector<HTMLElement>('[data-state="err"]');

    function errorSlot(input: HTMLElement): HTMLElement | null {
      const wrap = input.closest('label') ?? input.parentElement;
      return wrap?.querySelector<HTMLElement>('[data-error]') ?? null;
    }
    function setError(input: HTMLInputElement | HTMLSelectElement, msg: string) {
      const slot = errorSlot(input);
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      if (!slot) return;
      slot.hidden = !msg;
      slot.textContent = msg;
    }
    function validate(): boolean {
      if (!form) return false;
      let first: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]').forEach((el) => {
        const ok = el.checkValidity();
        setError(el, ok ? '' : (el.dataset.msg || 'This field is required.'));
        if (!ok && !first) first = el;
      });
      first?.focus();
      return !first;
    }
    function show(box: HTMLElement | null, on: boolean) {
      if (!box) return;
      box.classList.toggle('hidden', !on);
      box.classList.toggle('flex', on);
    }

    form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]').forEach((el) => {
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true' && el.checkValidity()) setError(el, ''); });
      el.addEventListener('change', () => { if (el.checkValidity()) setError(el, ''); });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Sending…';
      show(errBox, false);
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        const phone = (form.querySelector('[name=telefon]') as HTMLInputElement).value.trim();
        const okPhone = okBox?.querySelector<HTMLElement>('[data-ok-phone]');
        if (okPhone && phone) okPhone.textContent = phone;
        form.reset();
        form.classList.add('hidden');
        show(okBox, true);
        okBox?.focus();
      } catch {
        btn.disabled = false; btn.textContent = 'Get a free estimate';
        show(errBox, true);
        errBox?.focus();
      }
    });
  </script>
</Base>
