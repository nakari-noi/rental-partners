---
import Base from '../layouts/Base.astro';
---
<Base title="Stránka sa nenašla" description="Táto stránka neexistuje." noindex>
  <section class="wrap py-24">
    <div class="max-w-[640px]">
      <span class="chip">404</span>
      <h1 class="mt-5 text-[38px] md:text-[52px] leading-[1.08] font-bold tracking-[-0.02em]">Túto stránku sme nenašli</h1>
      <p class="mt-5 text-lg text-ink-soft">Možno sa presťahovala, ako niektorí naši hostia. Skúste domov alebo nám napíšte.</p>
      <div class="mt-8 flex flex-wrap gap-4"><a href="/" class="btn-primary">Na domovskú stránku</a><a href="/kontakt" class="btn-dark">Kontakt</a></div>
      <p class="mt-10 pt-6 border-t border-sand text-[15px] text-ink-soft" lang="en"><b class="text-ink">Page not found.</b> It may have moved, like some of our guests. <a href="/en" class="font-bold text-accent underline">English homepage</a> · <a href="/en/contact" class="font-bold text-accent underline">Contact</a></p>
    </div>
  </section>
</Base>
