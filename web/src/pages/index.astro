---
import Base from '../layouts/Base.astro';
---
<Base title="Správa bytov a garantovaný nájom v Bratislave" description="Rental Partners: byt vám spravujeme za 10 % z obratu, alebo si ho prenajmeme a platíme pevný nájom. Fotenie, hostia, upratovanie, údržba — v Bratislave.">
  <section class="container grid lg:grid-cols-[1.1fr_0.9fr] gap-12 py-14 lg:py-16 items-center">
    <div class="flex flex-col gap-6">
      <span class="chip self-start reveal">Správa bytov v Bratislave</span>
      <h1 class="reveal reveal-1 text-[44px] md:text-[56px] lg:text-[62px] leading-[1.06] font-bold tracking-[-0.02em]">Váš byt, náš tím.<br />Za vás riešime<br /><span class="text-accent">hostí.</span></h1>
      <p class="reveal reveal-2 text-lg leading-relaxed text-ink-soft max-w-[500px]">Sme partneri, nie sprostredkovatelia. Byt vám buď spravujeme za 10 % z obratu, alebo si ho od vás prenajmeme a platíme vám pevný nájom. V oboch prípadoch sa o všetko staráme my.</p>
      <div class="reveal reveal-3 flex flex-wrap gap-4 items-center">
        <a href="/kontakt" class="btn-primary">Chcem odhad výnosu</a>
        <a href="#modely" class="inline-flex items-center gap-2 px-2 py-4 font-bold text-[15px]">Dva spôsoby spolupráce ↓</a>
      </div>
    </div>
    <div class="reveal reveal-2 relative h-[420px] lg:h-[500px]">
      <div class="absolute top-6 right-0 w-[88%] h-[380px] rounded-[var(--radius-block)] overflow-hidden rotate-2 shadow-[var(--shadow-float)]">
        <img src="/img/byt-2br-dizajn.avif" alt="Interiér bytu s oceneným dizajnom" class="w-full h-full object-cover" width="1200" height="795" />
      </div>
      <div class="absolute left-0 bottom-0 z-10 flex items-center gap-3.5 px-5 py-4 bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-float)]">
        <div class="w-11 h-11 rounded-full bg-sage flex items-center justify-center text-white">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"></path></svg>
        </div>
        <div>
          <div class="display text-lg font-bold">4,89 z 5 · Superhost</div>
          <div class="text-[13px] text-ink-soft">Airbnb 109 recenzií · Booking 9,6 z 10 · 695 hodnotení</div>
        </div>
      </div>
    </div>
  </section>

  <section id="modely" class="container py-16">
    <p class="eyebrow">Modely spolupráce</p>
    <h2 class="mt-2 text-3xl md:text-[38px] font-bold tracking-[-0.02em] leading-[1.15]">Dva spôsoby, ako s nami spolupracovať</h2>
    <p class="mt-3 text-ink-soft max-w-[700px]">Kostra webu — ďalšie sekcie sa doplnia podľa návrhu.</p>
  </section>
</Base>
