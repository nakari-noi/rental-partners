---
import Base from '../layouts/Base.astro';
// Formulár posiela dáta na Web3Forms (bez backendu). Verejný kľúč účtu rentalpartners2026@gmail.com (7. 9. 2026).
const FORM_KEY = '047840b6-c6cd-46ef-b8c8-a73fb9cac26c';
const phoneIcon = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2.2z';
---
<Base title="Kontakt a nezáväzný odhad výnosu bytu" breadcrumb="Kontakt" description="Napíšte nám o svojom byte v Bratislave. Ozveme sa, stretneme sa priamo v byte a pripravíme odhad výnosu — zadarmo a nezáväzne. Tel. +421 903 989 040.">
  <section class="wrap pt-10 pb-6 lg:pt-14">
    <span class="chip">Kontakt</span>
    <h1 class="mt-5 text-[38px] md:text-[52px] leading-[1.08] font-bold tracking-[-0.02em] max-w-[820px] text-pretty">Poďme sa porozprávať o vašom byte</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft max-w-[640px]">Napíšte nám pár informácií o byte. Ozveme sa čo najskôr a dohodneme stretnutie priamo v byte — odhad výnosu je zadarmo a nezáväzný.</p>
  </section>

  <section class="wrap grid lg:grid-cols-[1.25fr_0.75fr] gap-8 lg:gap-10 pt-4 pb-16 items-start">
    <div class="flex flex-col gap-5">
      <!-- Pred formulárom: kedy odpovieme + telefón ako druhý kanál -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-5 py-4 sm:px-6 bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-float)]">
        <div class="flex items-center gap-3.5">
          <span class="w-12 h-12 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
          <p class="text-[15px] leading-snug text-ink-soft"><b class="text-ink">Odpovieme čo najskôr.</b><br />Odhad výnosu je zadarmo a nezáväzný. Formulár zaberie minútu.</p>
        </div>
        <a href="tel:+421903989040" class="btn-dark !text-[15px] !py-3 gap-2.5 whitespace-nowrap self-start sm:self-auto"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg>Zavolať · +421 903 989 040</a>
      </div>

      <form action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-5 p-6 md:p-9 bg-surface rounded-[var(--radius-block)]" id="dopyt" novalidate>
        <input type="hidden" name="access_key" value={FORM_KEY} />
        <input type="hidden" name="subject" value="Nový dopyt z rentalpartners.sk" />
        <input type="hidden" name="from_name" value="Web Rental Partners" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <p class="form-section">1 · O byte</p>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>Kde je byt (mestská časť) <span class="text-accent" aria-hidden="true">*</span></span>
            <input class="field" type="text" name="lokalita" placeholder="napr. Ružinov" required autocomplete="address-level2" data-msg="Napíšte mestskú časť, napr. Ružinov alebo Staré Mesto." />
            <span class="form-error" data-error hidden></span>
          </label>
          <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>Veľkosť bytu <span class="text-accent" aria-hidden="true">*</span></span>
            <select class="field" name="velkost" required data-msg="Vyberte veľkosť bytu."><option value="">Vyberte</option><option>Garsónka / 1-izbový</option><option>2-izbový</option><option>3-izbový</option><option>4-izbový a väčší</option></select>
            <span class="form-error" data-error hidden></span>
          </label>
        </div>
        <fieldset class="flex flex-col gap-2.5">
          <legend class="text-[13px] font-bold text-ink-soft mb-2.5">Byt je momentálne</legend>
          <div class="flex flex-wrap gap-2.5">
            <label class="pill relative"><input type="radio" name="stav" value="Prázdny" />Prázdny</label>
            <label class="pill relative"><input type="radio" name="stav" value="Prenajatý dlhodobo" />Prenajatý dlhodobo</label>
            <label class="pill relative"><input type="radio" name="stav" value="Už na Airbnb / Booking" />Už na Airbnb / Booking</label>
          </div>
        </fieldset>
        <fieldset class="flex flex-col gap-2.5">
          <legend class="text-[13px] font-bold text-ink-soft mb-2.5">Zaujíma ma</legend>
          <div class="flex flex-wrap gap-2.5">
            <label class="pill relative"><input type="radio" name="zaujem" value="Správa bytu · 10 %" />Správa bytu · 10 %</label>
            <label class="pill relative"><input type="radio" name="zaujem" value="Garantovaný nájom" />Garantovaný nájom</label>
            <label class="pill relative"><input type="radio" name="zaujem" value="Neviem, poraďte mi" checked />Neviem, poraďte mi</label>
          </div>
        </fieldset>

        <p class="form-section mt-1">2 · Kam sa máme ozvať</p>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>Meno a priezvisko <span class="text-accent" aria-hidden="true">*</span></span>
            <input class="field" type="text" name="meno" required autocomplete="name" data-msg="Napíšte, ako vás máme osloviť." />
            <span class="form-error" data-error hidden></span>
          </label>
          <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>Telefón <span class="text-accent" aria-hidden="true">*</span></span>
            <input class="field" type="tel" name="telefon" required autocomplete="tel" inputmode="tel" placeholder="+421 9xx xxx xxx" pattern="[\+0-9 \(\)\/\.\-]{9,20}" data-msg="Toto nevyzerá ako telefónne číslo. Zadajte ho v tvare +421 903 123 456 — zavoláme naň." />
            <span class="text-[12px] font-normal text-ink-soft">Zavoláme na toto číslo.</span>
            <span class="form-error" data-error hidden></span>
          </label>
        </div>
        <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft"><span>E-mail <span class="text-accent" aria-hidden="true">*</span></span>
          <input class="field" type="email" name="email" required autocomplete="email" data-msg="E-mailu chýba časť za zavináčom, napr. meno@gmail.com." />
          <span class="form-error" data-error hidden></span>
        </label>
        <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft">Čo by ste chceli vedieť (nepovinné)<textarea class="field" name="sprava"></textarea></label>
        <label class="flex items-start gap-3 text-[13px] leading-relaxed text-ink-soft">
          <input type="checkbox" name="suhlas" required class="mt-0.5 w-6 h-6 shrink-0 accent-[#c9694a]" data-msg="Bez súhlasu vám nemôžeme odpovedať — zaškrtnite ho, prosím." />
          <span>Súhlasím so spracovaním údajov na účel odpovede na môj dopyt. <a href="/ochrana-osobnych-udajov" class="underline">Ochrana osobných údajov</a><span class="form-error block" data-error hidden></span></span>
        </label>
        <button type="submit" class="btn-primary text-base py-[18px]">Chcem odhad výnosu</button>
        <p class="text-center text-[12px] text-ink-soft"><span class="text-accent">*</span> povinné · nič vám nepošleme bez vášho súhlasu</p>
      </form>

      <!-- Stav: úspech -->
      <div class="hidden flex-col gap-4 p-6 md:p-8 bg-sage-soft rounded-[var(--radius-block)]" data-state="ok" role="status" aria-live="polite" tabindex="-1">
        <span class="w-12 h-12 rounded-full bg-sage text-white flex items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg></span>
        <h2 class="display text-2xl font-bold">Ďakujeme, dopyt sme dostali.</h2>
        <p class="text-[15px] leading-relaxed">Ozveme sa vám na <b data-ok-phone>vaše číslo</b> čo najskôr. Ak vám vyhovuje iný čas, napíšte nám ho na <a href="mailto:rentalpartners2026@gmail.com" class="underline">rentalpartners2026@gmail.com</a>.</p>
        <a href="/vysledky" class="link-inline !text-accent-deep">Medzitým: pozrite si byty, o ktoré sa staráme →</a>
      </div>

      <!-- Stav: chyba -->
      <div class="hidden flex-col gap-4 p-6 md:p-8 bg-sand rounded-[var(--radius-block)]" data-state="err" role="alert" tabindex="-1">
        <span class="w-12 h-12 rounded-full bg-accent-deep text-white flex items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 8v5M12 16.5v.5"></path></svg></span>
        <h2 class="display text-2xl font-bold">Odoslanie sa nepodarilo.</h2>
        <p class="text-[15px] leading-relaxed">Vaše údaje vo formulári zostali vyplnené. Skúste to o chvíľu znova, alebo nám zavolajte priamo:</p>
        <a href="tel:+421903989040" class="btn-dark justify-center gap-2.5"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg>Tomáš · +421 903 989 040</a>
        <a href="tel:+421904809476" class="inline-flex items-center justify-center py-3 px-5 bg-surface rounded-full font-bold text-[15px]">Amanda · +421 904 809 476</a>
        <p class="text-sm text-center">alebo <a href="mailto:rentalpartners2026@gmail.com" class="font-bold text-accent-deep underline">rentalpartners2026@gmail.com</a></p>
      </div>
    </div>

    <div class="flex flex-col gap-5">
      <div class="flex flex-col gap-4 p-7 bg-surface rounded-[var(--radius-block)]">
        <h2 class="text-xl font-semibold">Radšej priamo?</h2>
        <a href="tel:+421903989040" class="flex items-center gap-3 text-[15px] min-h-11"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg></span><span>Tomáš · +421 903 989 040</span></a>
        <a href="tel:+421904809476" class="flex items-center gap-3 text-[15px] min-h-11"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon}></path></svg></span><span>Amanda · +421 904 809 476</span></a>
        <a href="mailto:rentalpartners2026@gmail.com" class="flex items-center gap-3 text-[15px] min-h-11"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span><span>rentalpartners2026@gmail.com</span></a>
        <div class="flex items-center gap-3 text-[15px]"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span><span>Námestie 1. mája 8062/11, 811 06 Bratislava – Staré Mesto</span></div>
      </div>
      <div class="flex flex-col gap-4 p-7 bg-sand rounded-[var(--radius-block)]">
        <h2 class="text-xl font-semibold">Čo bude nasledovať</h2>
        <ol class="flex flex-col gap-3 text-[15px] leading-relaxed">
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">01</b>Ozveme sa a dohodneme termín.</li>
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">02</b>Stretneme sa v byte, pozrieme lokalitu a stav.</li>
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">03</b>Dostanete odhad výnosu a návrh zmluvy. Rozhodnutie je na vás.</li>
        </ol>
      </div>
      <a href="https://www.openstreetmap.org/?mlat=48.1493&mlon=17.1116#map=17/48.1493/17.1116" target="_blank" rel="noopener" class="block rounded-[var(--radius-block)] overflow-hidden h-[240px]" aria-label="Otvoriť mapu — Námestie 1. mája, Bratislava">
        <img src="/img/mapa-stare-mesto.webp" alt="Mapa Starého Mesta s vyznačeným Námestím 1. mája" class="w-full h-full object-cover" width="760" height="471" loading="lazy" />
      </a>
      <p class="text-[12px] text-ink-soft -mt-2">Mapa © prispievatelia OpenStreetMap · <a href="https://www.openstreetmap.org/?mlat=48.1493&mlon=17.1116#map=17/48.1493/17.1116" target="_blank" rel="noopener" class="underline inline-flex items-center min-h-11">Otvoriť väčšiu mapu</a></p>
    </div>
  </section>

  <script>
    const form = document.getElementById('dopyt') as HTMLFormElement | null;
    const okBox = document.querySelector<HTMLElement>('[data-state="ok"]');
    const errBox = document.querySelector<HTMLElement>('[data-state="err"]');

    function errorSlot(input: HTMLElement): HTMLElement | null {
      const wrap = input.closest('label') ?? input.parentElement;
      return wrap?.querySelector<HTMLElement>('[data-error]') ?? null;
    }
    function setError(input: HTMLInputElement | HTMLSelectElement, msg: string) {
      const slot = errorSlot(input);
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      if (!slot) return;
      slot.hidden = !msg;
      slot.textContent = msg;
    }
    function validate(): boolean {
      if (!form) return false;
      let first: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]').forEach((el) => {
        const ok = el.checkValidity();
        setError(el, ok ? '' : (el.dataset.msg || 'Toto pole je povinné.'));
        if (!ok && !first) first = el;
      });
      first?.focus();
      return !first;
    }
    function show(box: HTMLElement | null, on: boolean) {
      if (!box) return;
      box.classList.toggle('hidden', !on);
      box.classList.toggle('flex', on);
    }

    form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]').forEach((el) => {
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true' && el.checkValidity()) setError(el, ''); });
      el.addEventListener('change', () => { if (el.checkValidity()) setError(el, ''); });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Odosielam…';
      show(errBox, false);
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        const phone = (form.querySelector('[name=telefon]') as HTMLInputElement).value.trim();
        const okPhone = okBox?.querySelector<HTMLElement>('[data-ok-phone]');
        if (okPhone && phone) okPhone.textContent = phone;
        form.reset();
        form.classList.add('hidden');
        show(okBox, true);
        okBox?.focus();
      } catch {
        btn.disabled = false; btn.textContent = 'Chcem odhad výnosu';
        show(errBox, true);
        errBox?.focus();
      }
    });
  </script>
</Base>
