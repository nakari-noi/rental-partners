---
import Base from '../layouts/Base.astro';
// Formulár posiela dáta na Web3Forms (bez backendu). Kľúč sa doplní po registrácii na web3forms.com.
const FORM_KEY = 'DOPLNIT_WEB3FORMS_KEY';
---
<Base title="Kontakt" description="Napíšte nám pár informácií o byte. Ozveme sa, stretneme sa priamo v byte a odhad výnosu je zadarmo a nezáväzný.">
  <section class="wrap pt-10 pb-6 lg:pt-14">
    <span class="chip">Kontakt</span>
    <h1 class="mt-5 text-[38px] md:text-[52px] leading-[1.08] font-bold tracking-[-0.02em] max-w-[820px] text-pretty">Poďme sa porozprávať o vašom byte</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft max-w-[640px]">Napíšte nám pár informácií o byte. Ozveme sa čo najskôr a dohodneme stretnutie priamo v byte — odhad výnosu je zadarmo a nezáväzný.</p>
  </section>

  <section class="wrap grid lg:grid-cols-[1.25fr_0.75fr] gap-8 lg:gap-10 pt-4 pb-16 items-start">
    <form action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-5 p-6 md:p-9 bg-surface rounded-[var(--radius-block)]" id="dopyt">
      <input type="hidden" name="access_key" value={FORM_KEY} />
      <input type="hidden" name="subject" value="Nový dopyt z rentalpartners.sk" />
      <input type="hidden" name="from_name" value="Web Rental Partners" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft">Meno a priezvisko<input class="field" type="text" name="meno" required autocomplete="name" /></label>
        <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft">Telefón<input class="field" type="tel" name="telefon" required autocomplete="tel" /></label>
      </div>
      <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft">E-mail<input class="field" type="email" name="email" required autocomplete="email" /></label>
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft">Kde je byt (mestská časť)<input class="field" type="text" name="lokalita" placeholder="napr. Staré Mesto" /></label>
        <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft">Veľkosť bytu
          <select class="field" name="velkost"><option value="">Vyberte</option><option>Garsónka / 1-izbový</option><option>2-izbový</option><option>3-izbový</option><option>4-izbový a väčší</option></select>
        </label>
      </div>
      <fieldset class="flex flex-col gap-2.5">
        <legend class="text-[13px] font-bold text-ink-soft mb-2.5">Byt je momentálne</legend>
        <div class="flex flex-wrap gap-2.5">
          <label class="pill relative"><input type="radio" name="stav" value="Prázdny" checked />Prázdny</label>
          <label class="pill relative"><input type="radio" name="stav" value="Prenajatý dlhodobo" />Prenajatý dlhodobo</label>
          <label class="pill relative"><input type="radio" name="stav" value="Už na Airbnb / Booking" />Už na Airbnb / Booking</label>
        </div>
      </fieldset>
      <fieldset class="flex flex-col gap-2.5">
        <legend class="text-[13px] font-bold text-ink-soft mb-2.5">Zaujíma ma</legend>
        <div class="flex flex-wrap gap-2.5">
          <label class="pill relative"><input type="radio" name="zaujem" value="Správa bytu · 10 %" />Správa bytu · 10 %</label>
          <label class="pill relative"><input type="radio" name="zaujem" value="Garantovaný nájom" />Garantovaný nájom</label>
          <label class="pill relative"><input type="radio" name="zaujem" value="Neviem, poraďte mi" checked />Neviem, poraďte mi</label>
        </div>
      </fieldset>
      <label class="flex flex-col gap-1.5 text-[13px] font-bold text-ink-soft">Čo by ste chceli vedieť (nepovinné)<textarea class="field" name="sprava"></textarea></label>
      <label class="flex items-start gap-2.5 text-[13px] leading-relaxed text-ink-soft"><input type="checkbox" name="suhlas" required class="mt-0.5 w-[18px] h-[18px] shrink-0 accent-[#c9694a]" /><span>Súhlasím so spracovaním údajov na účel odpovede na môj dopyt. <a href="/ochrana-osobnych-udajov" class="underline">Ochrana osobných údajov</a></span></label>
      <button type="submit" class="btn-primary text-base py-[18px]">Chcem odhad výnosu</button>
      <p class="text-[13px] text-ink-muted" data-form-note hidden>Ďakujeme, dopyt sme dostali. Ozveme sa čo najskôr.</p>
    </form>

    <div class="flex flex-col gap-5">
      <div class="flex flex-col gap-4 p-7 bg-surface rounded-[var(--radius-block)]">
        <h2 class="text-xl font-semibold">Radšej priamo?</h2>
        <a href="tel:+421903989040" class="flex items-center gap-3 text-[15px]"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2.2z"></path></svg></span><span>Tomáš · +421 903 989 040</span></a>
        <a href="tel:+421904809476" class="flex items-center gap-3 text-[15px]"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2.2z"></path></svg></span><span>Amanda · +421 904 809 476</span></a>
        <a href="mailto:rentalpartners2026@gmail.com" class="flex items-center gap-3 text-[15px]"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span><span>rentalpartners2026@gmail.com</span></a>
        <div class="flex items-center gap-3 text-[15px]"><span class="w-10 h-10 rounded-full bg-sage-soft text-sage flex items-center justify-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span><span>Námestie 1. mája 11, 811 06 Bratislava – Staré Mesto</span></div>
      </div>
      <div class="flex flex-col gap-4 p-7 bg-sand rounded-[var(--radius-block)]">
        <h2 class="text-xl font-semibold">Čo bude nasledovať</h2>
        <ol class="flex flex-col gap-3 text-[15px] leading-relaxed">
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">01</b>Ozveme sa a dohodneme termín.</li>
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">02</b>Stretneme sa v byte, pozrieme lokalitu a stav.</li>
          <li class="flex gap-3"><b class="display text-accent w-6 shrink-0">03</b>Dostanete odhad výnosu a návrh zmluvy. Rozhodnutie je na vás.</li>
        </ol>
      </div>
      <a href="https://www.openstreetmap.org/?mlat=48.1493&mlon=17.1116#map=17/48.1493/17.1116" target="_blank" rel="noopener" class="block rounded-[var(--radius-block)] overflow-hidden h-[240px]" aria-label="Otvoriť mapu — Námestie 1. mája, Bratislava">
        <img src="/img/mapa-stare-mesto.webp" alt="Mapa Starého Mesta s vyznačeným Námestím 1. mája" class="w-full h-full object-cover" width="760" height="471" loading="lazy" />
      </a>
      <p class="text-[12px] text-ink-muted -mt-2 py-2">Mapa © prispievatelia OpenStreetMap · <a href="https://www.openstreetmap.org/?mlat=48.1493&mlon=17.1116#map=17/48.1493/17.1116" target="_blank" rel="noopener" class="underline">Otvoriť väčšiu mapu</a></p>
    </div>
  </section>

  <script>
    const form = document.getElementById('dopyt') as HTMLFormElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      const note = form.querySelector('[data-form-note]') as HTMLElement;
      btn.disabled = true; btn.textContent = 'Odosielam…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset(); note.hidden = false; btn.textContent = 'Odoslané';
      } catch {
        note.hidden = false; note.textContent = 'Odoslanie sa nepodarilo. Zavolajte nám alebo napíšte na rentalpartners2026@gmail.com.';
        btn.disabled = false; btn.textContent = 'Chcem odhad výnosu';
      }
    });
  </script>
</Base>
