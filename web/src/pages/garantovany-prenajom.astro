---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Check from '../components/Check.astro';

// Garantovaný prenájom (model B). Fakty z docs/fakty.md, zo schválených textov v cenníku a z odpovedí klienta (13. 10.: nezariadený byt áno, po dohode; upratovanie pri garantovanom nájme platíme my).
// V titulku a nadpise tvar „garantovaný prenájom“ (ten ľudia hľadajú), v texte aj „garantovaný nájom“ (tak ho volá klient).

// Ilustračný rok: výnos z krátkodobého prenájmu podľa mesiacov (rovnaký priebeh ako v cenníku) a pevný nájom ako čiara
const months = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
const season = [52, 48, 60, 72, 84, 94, 100, 100, 86, 68, 54, 70];
const barColor = (h: number) => (h >= 100 ? 'var(--color-accent)' : h >= 84 ? 'var(--color-sand-deep)' : 'var(--color-sand)');
const rentLine = 62;

const promises = [
  { n: '15.', t: 'Nájom vopred, vždy k 15. dňu v mesiaci', d: 'Žiadne vyúčtovania. Jedna dohodnutá suma, s ktorou viete počítať.' },
  { n: '12×', t: 'Platíme každý mesiac v roku', d: 'Aj v mesiacoch, keď je byt prázdny. Riziko obsadenosti je naše.' },
  { n: '0 €', t: 'Za upratovanie, energie a prevádzku', d: 'Hradíme ich my. Opravy, ktoré s krátkodobým prenájmom nesúvisia ani ním neboli spôsobené, ostávajú na majiteľovi.' },
];
const situations = [
  { t: 'Byt máte prázdny alebo zdedený', d: 'Bude zarábať a vy sa oň nemusíte starať. Nájom chodí každý mesiac, o hostí sa staráme my.', i: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { t: 'Prenajímate dlhodobo a hľadanie nájomcov vás nebaví', d: 'Pevná suma ako od nájomcu, ale bez hľadania, striedania a obhliadok.', i: 'M4 6h16v14H4z M4 10h16 M8 3v4 M16 3v4' },
  { t: 'Prenajímate na Airbnb sami a už vás to unavuje', d: 'Hostí, upratovanie aj ceny prevezmeme. Vy dostávate rovnakú sumu každý mesiac.', i: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z' },
];
const steps = [
  { t: 'Obhliadka bytu', d: 'Prídeme sa pozrieť na byt a lokalitu.' },
  { t: 'Odhad', d: 'Odhadneme, koľko byt na krátkodobom prenájme zarobí za rok.' },
  { t: 'Návrh nájmu a zmluvy', d: 'Navrhneme pevný mesačný nájom a zmluvu. Rozhodnutie je na vás.' },
  { t: 'Nájom každý mesiac', d: 'Po podpise vám platíme dohodnutú sumu vopred, vždy k 15. dňu v mesiaci.' },
];
const compare = [
  { label: 'Váš príjem', b: 'Pevná suma každý mesiac', a: 'Výnos podľa obsadenosti, my si berieme 10 % z obratu' },
  { label: 'Kedy platíme', b: 'Vopred, vždy k 15. dňu v mesiaci', a: 'Po vyúčtovaní, do 10. dňa nasledujúceho mesiaca' },
  { label: 'Upratovanie a prevádzka', b: 'Hradíme my', a: 'Energie, internet, spotrebný materiál a poplatky platforiem hradí majiteľ' },
  { label: 'Hostia, upratovanie, údržba', b: 'Riešime my', a: 'Riešime my' },
  { label: 'Byt pre vás', b: 'Termíny dohodneme v zmluve', a: 'Termíny si viete blokovať podľa dohody' },
];
// Otázky majiteľov: na stránke aj v štruktúrovaných dátach (FAQPage)
const faq = [
  { q: 'Kedy dostanem nájom?', a: 'Vopred, vždy k 15. dňu v mesiaci. Žiadne vyúčtovania, jedna dohodnutá suma.' },
  { q: 'Čo ak je byt prázdny?', a: 'Nájom vám platíme rovnako. Riziko obsadenosti je naše.' },
  { q: 'Ako určíte výšku nájmu?', a: 'Suma je individuálna. Vychádza z trhových hodnôt nájmu v lokalite a zo stavu bytu.' },
  { q: 'Musí byť byt zariadený?', a: 'Nie nevyhnutne. Aj nezariadený byt vieme vziať, podmienky dohodneme individuálne.' },
  { q: 'Kto platí upratovanie, energie a opravy?', a: 'Pri garantovanom nájme hradíme upratovanie, energie aj prevádzku my. Opravy, ktoré s krátkodobým prenájmom nesúvisia ani ním neboli spôsobené, ostávajú na majiteľovi.' },
  { q: 'Môžem byt používať aj ja?', a: 'Áno. Termíny, kedy bude byt pre vás, dohodneme v zmluve.' },
  { q: 'Na ako dlho sa podpisuje zmluva?', a: 'Dĺžku zmluvy a výpovednú lehotu dohodneme na stretnutí. Sú individuálne, podľa podmienok, na ktorých sa vopred dohodneme.' },
  { q: 'Aký je rozdiel oproti správe za 10 %?', a: 'Pri správe dostávate výnos podľa obsadenosti a my si berieme 10 % z obratu, v sezóne zarobíte viac, mimo nej menej. Pri garantovanom nájme dostávate každý mesiac rovnakú sumu bez ohľadu na obsadenosť.' },
];
const star = 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z';
---
<Base title="Garantovaný prenájom bytu v Bratislave" breadcrumb="Garantovaný nájom" description="Byt si od vás prenajmeme a platíme pevný nájom vopred každý mesiac, bez ohľadu na obsadenosť. Garantovaný prenájom bytu v Bratislave od Rental Partners." faq={faq} service={{ name: 'Garantovaný prenájom bytu', serviceType: 'Garantovaný nájom bytu', description: 'Byt si od majiteľa prenajmeme, platíme mu pevný mesačný nájom vopred bez ohľadu na obsadenosť a byt prevádzkujeme na krátkodobý prenájom na vlastné riziko.' }}>
  <!-- Hero: hlavný prínos vľavo, motív „byt + dôkaz“ vpravo (naklonená fotka s plávajúcou kartou výplaty) -->
  <section class="wrap grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-14 pt-10 pb-14 lg:pt-14 lg:pb-20 items-center">
    <div class="flex flex-col gap-6">
      <h1 class="chip self-start">Garantovaný prenájom bytu v Bratislave</h1>
      <p class="display text-[40px] sm:text-[50px] lg:text-[58px] leading-[1.05] font-bold tracking-[-0.025em] text-pretty">Pevná suma každý mesiac, <span class="text-accent">aj keď je byt prázdny.</span></p>
      <p class="text-lg leading-relaxed text-ink-soft max-w-[560px]">Byt si od vás prenajmeme a platíme vám dohodnutý nájom vopred, vždy k 15. dňu v mesiaci. Krátkodobý prenájom na Airbnb a Booking robíme na vlastné riziko. Hostí, upratovanie aj starostlivosť o byt riešime my.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/kontakt" class="btn-primary">Chcem návrh nájmu</a>
        <span class="text-sm text-ink-soft">Zadarmo a nezáväzne.<br class="hidden sm:block" /> Prídeme sa na byt pozrieť.</span>
      </div>
      <p class="flex items-center gap-3 pt-5 border-t border-sand text-sm leading-relaxed text-ink-soft">
        <span class="w-9 h-9 rounded-full bg-sage text-white inline-flex items-center justify-center shrink-0" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d={star}></path></svg></span>
        <span><b class="text-ink">4,89 z 5 na Airbnb · Superhost</b> · Booking 9,6 z 10<br />804 hodnotení hostí, verejné a overiteľné</span>
      </p>
    </div>
    <div class="relative h-[440px] sm:h-[500px] lg:h-[540px]">
      <div class="absolute top-0 right-0 w-[82%] h-[88%] rounded-[var(--radius-block)] overflow-hidden rotate-2 shadow-[var(--shadow-float)]">
        <img src="/img/byt-nove-utulne.avif" alt="Útulný byt v centre Bratislavy pripravený na krátkodobý prenájom" class="w-full h-full object-cover" width="1200" height="1804" fetchpriority="high" decoding="async" />
      </div>
      <span class="absolute top-6 right-4 sm:right-6 inline-flex items-center gap-2 px-3.5 py-2 bg-white/95 rounded-full text-[13px] font-bold text-ink shadow-[var(--shadow-float)]">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6e8b6a" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
        Riziko obsadenosti je naše
      </span>
      <div class="absolute left-0 bottom-0 w-[min(320px,86%)] flex flex-col gap-3 p-5 bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-float)]">
        <span class="text-[13px] font-bold text-ink-muted">Nájom na váš účet</span>
        <span class="display text-[26px] font-bold leading-none">vždy k 15. dňu</span>
        <div class="flex items-end gap-1 h-7" aria-hidden="true">{months.map(() => <span class="flex-1 h-full rounded-[3px] bg-sage"></span>)}</div>
        <span class="text-[13px] text-ink-soft">Rovnaká suma všetkých 12 mesiacov</span>
      </div>
    </div>
  </section>

  <!-- Istota oproti sezóne: jediný pohyb na stránke (stĺpce narastú, čiara nájmu sa dokreslí) -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="wrap grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-center">
      <div class="flex flex-col gap-5">
        <p class="eyebrow">Istota</p>
        <h2 class="text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] text-pretty">Krátkodobý prenájom má sezónu. Váš nájom nie.</h2>
        <p class="text-[17px] leading-relaxed text-ink-soft">V sezóne býva byt obsadený okolo 95 % nocí, mimo nej 60 až 70 %. Pri garantovanom nájme ten rozdiel nesieme my a vy dostávate každý mesiac rovnakú sumu.</p>
        <ul class="flex flex-col gap-2.5 text-[15px]">
          <li class="flex items-center gap-3"><span class="w-6 h-3 rounded-[3px] bg-sand-deep shrink-0" aria-hidden="true"></span>Výnos z krátkodobého prenájmu, mení sa podľa mesiaca</li>
          <li class="flex items-center gap-3"><span class="w-6 h-[3px] rounded-full bg-sage shrink-0" aria-hidden="true"></span>Váš garantovaný nájom, rovnaký každý mesiac</li>
        </ul>
      </div>
      <figure class="flex flex-col gap-5 p-6 md:p-9 bg-bg rounded-[var(--radius-block)]" data-chart>
        <div class="flex items-center justify-between gap-3">
          <span class="display text-lg font-bold">Jeden rok prenájmu</span>
          <span class="chip !bg-surface !py-1 !px-2.5 text-[12px]">ilustračný príklad</span>
        </div>
        <div class="relative h-[220px] md:h-[260px]">
          <div class="absolute inset-0 flex items-end gap-1.5 md:gap-2" aria-hidden="true">
            {season.map((h, i) => <span class="bar flex-1 rounded-t-[6px]" style={`height:${h}%;background:${barColor(h)};--i:${i}`}></span>)}
          </div>
          <div class="rent-line absolute inset-x-0 flex items-center" style={`bottom:${rentLine}%`} aria-hidden="true">
            <span class="flex-1 h-[3px] rounded-full bg-sage"></span>
            <span class="absolute right-0 bottom-[calc(100%+6px)] px-2.5 py-1 rounded-full bg-sage text-white text-[12px] font-bold whitespace-nowrap">Váš nájom</span>
          </div>
        </div>
        <div class="flex gap-1.5 md:gap-2 -mt-2 text-[11px] font-bold text-ink-muted text-center" aria-hidden="true">{months.map((m) => <span class="flex-1">{m}</span>)}</div>
        <figcaption class="text-[13px] leading-relaxed text-ink-soft">Stĺpce ukazujú, ako sa výnos z krátkodobého prenájmu mení počas roka. Čiara je garantovaný nájom, rovnaký v každom mesiaci. Ilustračný príklad, nie skutočné čísla.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Čo dostanete: tri prísľuby s veľkými kotvami namiesto mriežky kariet -->
  <section class="wrap py-16 lg:py-24">
    <p class="eyebrow">Čo dostanete</p>
    <h2 class="mt-2 text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] max-w-[760px] text-pretty">Tri veci, s ktorými môžete počítať</h2>
    <div class="mt-10 border-t border-sand">
      {promises.map((p) => (
        <div class="grid grid-cols-[88px_1fr] md:grid-cols-[180px_1fr_1fr] gap-x-6 md:gap-x-10 gap-y-2 py-7 md:py-9 border-b border-sand items-baseline">
          <span class="display row-span-2 md:row-span-1 text-[44px] md:text-[72px] leading-none font-bold tracking-[-0.03em] text-accent">{p.n}</span>
          <h3 class="text-xl md:text-[24px] font-semibold leading-snug">{p.t}</h3>
          <p class="text-[15px] md:text-base leading-relaxed text-ink-soft">{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Sebaidentifikácia: majiteľ si nájde svoju situáciu -->
  <section class="bg-sand py-16 lg:py-24">
    <div class="wrap">
      <p class="eyebrow">Pre koho</p>
      <h2 class="mt-2 text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] max-w-[760px] text-pretty">Spoznávate sa v niektorej situácii?</h2>
      <div class="grid md:grid-cols-3 gap-5 mt-10">
        {situations.map((s) => (
          <div class="flex flex-col gap-4 p-7 bg-surface rounded-[var(--radius-card)]">
            <span class="w-12 h-12 rounded-full bg-sage-soft text-sage inline-flex items-center justify-center" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={s.i}></path></svg></span>
            <h3 class="text-xl font-semibold leading-snug">{s.t}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft">{s.d}</p>
            <span class="mt-auto pt-4 border-t border-sand text-[13px] font-bold text-sage">Garantovaný nájom sedí</span>
          </div>
        ))}
      </div>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mt-5 px-7 py-6 bg-bg rounded-[var(--radius-card)]">
        <p class="text-[15px] leading-relaxed"><b>Chcete z bytu vyťažiť maximum</b> a zvládnete, že sa príjem mesiac od mesiaca líši? Lepšia bude správa bytu za 10 %.</p>
        <a href="/sluzby" class="link-inline whitespace-nowrap shrink-0">Pozrieť správu bytu →</a>
      </div>
    </div>
  </section>

  <!-- Postup ako časová os -->
  <section id="vyska-najmu" class="bg-surface py-16 lg:py-24 scroll-mt-6">
    <div class="wrap">
      <p class="eyebrow">Postup</p>
      <h2 class="mt-2 text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1]">Ako určíme výšku nájmu</h2>
      <p class="mt-4 text-[17px] leading-relaxed text-ink-soft max-w-[620px]">Suma je individuálna. Vychádza z trhových hodnôt nájmu v lokalite a zo stavu bytu.</p>
      <div class="relative mt-12">
        <span class="hidden lg:block absolute top-[22px] left-[22px] right-[12%] h-[2px] bg-sand" aria-hidden="true"></span>
        <ol class="relative grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
          {steps.map((s, i) => (
            <li class="flex flex-col gap-3">
              <span class:list={['display w-11 h-11 rounded-full text-[15px] font-semibold flex items-center justify-center', i === steps.length - 1 ? 'bg-accent text-white' : 'bg-ink text-bg']} aria-hidden="true">{i + 1}</span>
              <h3 class="text-lg font-semibold leading-snug">{s.t}</h3>
              <p class="text-[15px] leading-relaxed text-ink-soft max-w-[260px]">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
      <p class="flex items-start gap-3 mt-12 p-5 bg-sage-soft rounded-[var(--radius-card)] max-w-[640px] text-[15px] leading-relaxed">
        <svg class="shrink-0 mt-0.5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6e8b6a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
        <span><b>Nezariadený byt?</b> Aj ten vieme vziať. Podmienky dohodneme individuálne.</span>
      </p>
    </div>
  </section>

  <!-- Sociálny dôkaz a autorita: ten istý tím a skutočná recenzia -->
  <section class="wrap grid md:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-16 items-center py-16 lg:py-24">
    <div class="relative h-[380px] md:h-[440px]">
      <div class="absolute inset-y-0 left-0 w-[86%] rounded-[var(--radius-block)] overflow-hidden -rotate-2 shadow-[var(--shadow-float)]">
        <img src="/img/tomas.webp" alt="Tomáš, zakladateľ Rental Partners" class="w-full h-full object-cover object-[50%_25%]" width="640" height="800" loading="lazy" />
      </div>
      <div class="absolute right-0 bottom-8 flex items-center gap-3 pl-4 pr-5 py-4 bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-float)]">
        <span class="w-10 h-10 rounded-full bg-sage text-white inline-flex items-center justify-center shrink-0" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d={star}></path></svg></span>
        <span><span class="display block text-lg font-bold leading-tight">4,89 z 5</span><span class="block text-[13px] text-ink-soft">Superhost na Airbnb</span></span>
      </div>
    </div>
    <div class="flex flex-col gap-5">
      <p class="eyebrow">Kto sa o byt stará</p>
      <h2 class="text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] text-pretty">O váš byt sa postará ten istý tím</h2>
      <p class="text-[17px] leading-relaxed text-ink-soft">Byty v garantovanom nájme vedieme rovnako ako všetky ostatné. Hostia nás hodnotia 4,89 z 5 na Airbnb a 9,6 z 10 na Bookingu.</p>
      <blockquote class="flex flex-col gap-3 pl-5 border-l-[1px] border-sand">
        <p class="display text-xl md:text-[22px] leading-[1.4] italic">„Tomas bol veľmi nápomocný a vždy odpovedal okamžite. Určite jedno z najlepších miest na ubytovanie v Bratislave.“</p>
        <footer class="text-sm text-ink-soft">Karl, Brunoy (Francúzsko) · Airbnb · júl 2026</footer>
      </blockquote>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="/vysledky" class="link-inline">Pozrieť hodnotenia →</a>
        <a href="tel:+421903989040" class="text-[15px] font-bold text-ink py-2">Tomáš · +421 903 989 040</a>
      </div>
    </div>
  </section>

  <!-- Porovnanie: zvýraznený stĺpec garantovaného nájmu -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="wrap">
      <p class="eyebrow">Porovnanie</p>
      <h2 class="mt-2 text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] text-pretty">Garantovaný nájom alebo správa za 10 %</h2>
      <div class="mt-10 grid md:grid-cols-[1fr_1.25fr_1.25fr] text-[15px]">
        <div class="hidden md:block"></div>
        <div class="hidden md:flex items-center gap-2 px-6 pt-6 pb-4 bg-sage-soft rounded-t-[var(--radius-card)] display text-lg font-bold">Garantovaný nájom</div>
        <div class="hidden md:flex items-center px-6 pt-6 pb-4 display text-lg font-bold text-ink-soft">Správa bytu za 10 %</div>
        {compare.map((c, i) => (
          <>
            <div class="pt-5 md:py-4 md:pr-6 font-bold md:border-t md:border-sand">{c.label}</div>
            <div class:list={['flex flex-col md:block gap-0.5 mt-2 md:mt-0 px-5 md:px-6 py-3 md:py-4 bg-sage-soft rounded-t-[14px] md:rounded-none', i === compare.length - 1 && 'md:rounded-b-[var(--radius-card)] md:pb-6']}><span class="md:hidden text-[12px] font-bold text-sage">Garantovaný nájom</span>{c.b}</div>
            <div class="flex flex-col md:block gap-0.5 px-5 md:px-6 py-3 md:py-4 bg-bg md:bg-transparent rounded-b-[14px] md:rounded-none md:border-t md:border-sand text-ink-soft"><span class="md:hidden text-[12px] font-bold text-ink-muted">Správa bytu za 10 %</span>{c.a}</div>
          </>
        ))}
      </div>
      <p class="mt-8 text-[15px] leading-relaxed text-ink-soft max-w-[720px]">Celé porovnanie oboch modelov aj s bežným dlhodobým prenájmom nájdete v <a href="/cennik" class="font-bold text-accent-deep underline">cenníku</a>.</p>
    </div>
  </section>

  <!-- Otázky ako rozbaľovací zoznam: menej textu naraz, odpovede ostávajú v HTML pre Google -->
  <section class="wrap grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16 py-16 lg:py-24">
    <div class="flex flex-col gap-4 lg:sticky lg:top-8 self-start">
      <p class="eyebrow">Otázky</p>
      <h2 class="text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] text-pretty">Na čo sa majitelia pýtajú</h2>
      <p class="text-[15px] leading-relaxed text-ink-soft">Odpoveď ste nenašli? Zavolajte Tomášovi na <a href="tel:+421903989040" class="font-bold text-ink whitespace-nowrap">+421 903 989 040</a>.</p>
    </div>
    <div class="border-t border-sand">
      {faq.map((f, i) => (
        <details class="faq group border-b border-sand" open={i === 0}>
          <summary class="flex items-center justify-between gap-6 py-5 cursor-pointer list-none text-lg font-semibold">
            {f.q}
            <span class="w-9 h-9 rounded-full bg-sand inline-flex items-center justify-center shrink-0 transition-transform group-open:rotate-45" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg></span>
          </summary>
          <p class="pb-6 pr-14 text-[15px] md:text-base leading-relaxed text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <Cta text="Pripravíme vám návrh nájmu pre váš byt." />
</Base>

<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 8px; }
  .bar { transform-origin: bottom; }
  [data-chart][data-armed] .bar { transform: scaleY(0); }
  [data-chart][data-armed] .rent-line { clip-path: inset(0 100% 0 0); }
  [data-chart].is-in .bar { transform: scaleY(1); transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 45ms); }
  [data-chart].is-in .rent-line { clip-path: inset(0 0 0 0); transition: clip-path 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.55s; }
</style>

<script>
  // Graf je viditeľný aj bez skriptu. Animácia sa zapne len pri podpore IntersectionObserver a bez preferencie obmedzeného pohybu.
  const charts = document.querySelectorAll<HTMLElement>('[data-chart]');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('is-in');
      io.unobserve(e.target);
    }), { threshold: 0.35 });
    charts.forEach((c) => { c.setAttribute('data-armed', ''); io.observe(c); });
  }
</script>
