---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Check from '../components/Check.astro';

const services = [
  { n: '01', title: 'Fotenie, inzeráty a ceny', img: '/img/ilu-fotenie.svg', alt: 'Ilustrácia: fotoaparát na statíve pred izbou',
    text: 'Byt profesionálne nafotíme, napíšeme texty v slovenčine aj angličtine a založíme profily na Airbnb a Booking. Ceny sledujeme priebežne podľa sezóny, dopytu a obsadenosti.',
    points: ['Profesionálne fotenie bytu a texty SK / EN', 'Profily na Airbnb, Booking a ďalších platformách', 'Priebežná úprava cien podľa sezóny'] },
  { n: '02', title: 'Hostia a komunikácia', img: '/img/ilu-hostia.svg', alt: 'Ilustrácia: telefón so správami a kľúč',
    text: 'Od prvej správy po odhlásenie. Hostia píšu nám, nie vám. Aj v sobotu o desiatej večer.',
    points: ['Odpovede na dopyty a rezervácie', 'Check-in, check-out, inštrukcie k bytu', 'Riešenie problémov počas pobytu a recenzie'] },
  { n: '03', title: 'Upratovanie a bielizeň', img: '/img/ilu-upratovanie.svg', alt: 'Ilustrácia: ustlaná posteľ a uteráky',
    text: 'Po každom odchode hostí byt upraceme, vymeníme posteľnú bielizeň a uteráky a doplníme, čo chýba. Zároveň skontrolujeme, či je všetko v poriadku.',
    points: ['Upratovanie po každom pobyte', 'Čistá bielizeň a uteráky', 'Kontrola stavu bytu po hosťoch'] },
  { n: '04', title: 'Údržba a starostlivosť o byt', img: '/img/ilu-udrzba.svg', alt: 'Ilustrácia: kohútik, kľúč a checklist',
    text: 'Kvapkajúci kohútik, zaseknutý zámok, vypálená žiarovka. Riešime ich hneď, keď to zbadáme, nie až po vašom telefonáte.',
    points: ['Drobné opravy', 'Koordinácia remeselníkov pri väčších poruchách', 'Pravidelná kontrola bytu'] },
];
// Postup od prvého stretnutia po vyúčtovanie. Fakty z docs/fakty.md a docs/texty.md, nič navyše.
const steps = [
  { t: 'Stretnutie v byte', d: 'Prídeme sa na byt pozrieť a pripravíme odhad výnosu. Zadarmo a nezáväzne.' },
  { t: 'Zmluva', d: 'Podpíšeme zmluvu o správe bytu. Podmienky prejdeme spolu, výpovedná lehota je 30 dní.' },
  { t: 'Fotky, inzeráty a ceny', d: 'Byt nafotíme, napíšeme texty v slovenčine aj angličtine, založíme profily na Airbnb a Booking a nastavíme ceny podľa sezóny.' },
  { t: 'Prvý hosť', d: 'Zvyčajne 2 dni až týždeň od podpisu zmluvy.' },
  { t: 'Každý pobyt', d: 'Odpovedáme na správy a posielame pokyny k príchodu. Kľúče sú v schránke na kľúče alebo v boxe. Počas pobytu riešime všetko, čo hosť potrebuje.' },
  { t: 'Po odchode hosťa', d: 'Byt upraceme, vymeníme posteľnú bielizeň a uteráky, doplníme, čo chýba, a skontrolujeme jeho stav. Postaráme sa aj o recenzie.' },
  { t: 'Koniec mesiaca', d: 'Dostanete prehľad príjmov, rezervácií a obsadenosti. Peniaze prídu do 10. dňa nasledujúceho mesiaca.' },
];
// Otázky majiteľov k správe bytu: na stránke aj v štruktúrovaných dátach (FAQPage)
const faq = [
  { q: 'Kto platí opravy?', a: 'Menšie opravy hradíme my. Pri väčších opravách záleží na tom, čím a ako vznikli.' },
  { q: 'Čo ak hosť niečo poškodí?', a: 'Škody nie sú také časté, ako si ľudia myslia, ale stávajú sa. Väčšinou ich vyriešime sami tak, že to vy riešiť nemusíte.' },
  { q: 'Kto platí energie a internet?', a: 'Pri správe bytu energie, internet, spotrebný materiál a poplatky platforiem hradí majiteľ. Menšie opravy hradíme my.' },
  { q: 'Ako rýchlo príde prvý hosť?', a: 'Zvyčajne 2 dni až týždeň od podpisu zmluvy.' },
  { q: 'Môžem byt používať aj ja?', a: 'Áno. Ako často a s akým predstihom si ho zablokujete, dohodneme prípad od prípadu.' },
  { q: 'Na ktorých platformách byt inzerujete?', a: 'Na Airbnb a Booking, podľa bytu aj na ďalších platformách.' },
];
---
<Base title="Správa bytu na Airbnb a Booking za 10 %" breadcrumb="Správa bytu" faq={faq} service={{ name: 'Správa bytu na Airbnb a Booking', serviceType: 'Správa krátkodobého prenájmu', description: 'Fotenie, inzeráty a ceny, komunikácia s hosťami, upratovanie, údržba a mesačné vyúčtovanie bytu na krátkodobý prenájom v Bratislave za 10 % z obratu.' }} description="Čo robí správca Airbnb: fotenie, inzeráty a ceny, komunikácia s hosťami, upratovanie, údržba a mesačné vyúčtovanie. Správa bytu v Bratislave za 10 %.">
  <section class="wrap pt-10 pb-8 lg:pt-14">
    <h1 class="chip">Správa bytu na Airbnb a Booking v Bratislave</h1>
    <p class="display mt-5 text-[38px] md:text-[52px] leading-[1.08] font-bold tracking-[-0.02em] max-w-[820px] text-pretty">Od prvej fotky po posledné upratovanie</p>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft max-w-[640px]">Päť vecí, ktoré by ste pri krátkodobom prenájme riešili každý týždeň, od fotenia po vyúčtovanie. Preberáme ich všetky, pri správe bytu aj pri <a href="/garantovany-prenajom" class="font-bold text-accent-deep underline">garantovanom nájme</a>.</p>
  </section>

  {services.map((s, i) => (
    <section class:list={['py-10 lg:py-14', i % 2 === 1 && 'bg-surface']}>
      <div class="wrap grid md:grid-cols-2 gap-8 lg:gap-14 items-center">
        <div class:list={['flex flex-col gap-4', i % 2 === 1 && 'md:order-2']}>
          <div class="display w-10 h-10 rounded-full bg-ink text-bg text-[15px] font-semibold flex items-center justify-center">{s.n}</div>
          <h2 class="text-[28px] md:text-[32px] font-bold tracking-[-0.02em] leading-[1.15]">{s.title}</h2>
          <p class="text-ink-soft leading-relaxed">{s.text}</p>
          <ul class="flex flex-col gap-2.5 mt-1">{s.points.map((p) => <Check>{p}</Check>)}</ul>
        </div>
        <div class:list={['aspect-[3/2] rounded-[var(--radius-block)] overflow-hidden', i % 2 === 1 && 'md:order-1']}>
          <img src={s.img} alt={s.alt} class="w-full h-full object-cover" width="600" height="400" loading="lazy" />
        </div>
      </div>
    </section>
  ))}

  <section class="wrap grid md:grid-cols-2 gap-8 lg:gap-14 items-center py-10 lg:py-14">
    <div class="flex flex-col gap-4">
      <div class="display w-10 h-10 rounded-full bg-ink text-bg text-[15px] font-semibold flex items-center justify-center">05</div>
      <h2 class="text-[28px] md:text-[32px] font-bold tracking-[-0.02em] leading-[1.15]">Mesačné vyúčtovanie</h2>
      <p class="text-ink-soft leading-relaxed">Každý mesiac dostanete prehľad: príjmy z pobytov, naša odmena 10 % a suma, ktorá ide vám.</p>
      <ul class="flex flex-col gap-2.5 mt-1">
        <Check>Prehľad príjmov a rezervácií za mesiac</Check>
        <Check>Výplata podľa dohody v zmluve</Check>
        <Check>Prehľad obsadenosti bytu</Check>
      </ul>
    </div>
    <div class="flex flex-col gap-3 p-7 bg-surface rounded-[var(--radius-block)]">
      <div class="flex justify-between items-center gap-3">
        <span class="text-[13px] font-bold text-ink-muted">Ukážka vyúčtovania · správa bytu</span>
        <span class="chip !py-1 !px-2.5 text-[12px] whitespace-nowrap">ilustračný príklad</span>
      </div>
      <div class="flex justify-between gap-4 py-2.5 border-b border-sand text-[15px]"><span>Príjmy z pobytov</span><b class="whitespace-nowrap">2 000 €</b></div>
      <div class="flex justify-between gap-4 py-2.5 border-b border-sand text-[15px]"><span>Odmena Rental Partners (10 %)</span><b class="whitespace-nowrap">− 200 €</b></div>
      <div class="flex justify-between gap-4 py-3 text-[17px]"><b>Zostáva vám</b><b class="display text-sage whitespace-nowrap">1 800 €</b></div>
      <p class="text-[12px] leading-relaxed text-ink-muted">Pri garantovanom nájme vyúčtovanie odpadá, dostávate dohodnutú sumu.</p>
    </div>
  </section>

  <section class="bg-surface py-14 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Postup</p>
      <h2 class="mt-2 text-[30px] md:text-[36px] font-bold tracking-[-0.02em] leading-[1.15]">Ako správa bytu funguje v praxi</h2>
      <p class="mt-3 text-[17px] leading-relaxed text-ink-soft max-w-[680px]">Od prvého stretnutia po mesačné vyúčtovanie. Takto to prebieha pri každom byte, ktorý spravujeme na Airbnb a Booking.</p>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        {steps.map((s, i) => (
          <li class="flex flex-col gap-2.5 p-5 bg-bg rounded-[var(--radius-card)]">
            <span class="display w-9 h-9 rounded-full bg-ink text-bg text-[14px] font-semibold flex items-center justify-center" aria-hidden="true">{i + 1}</span>
            <h3 class="text-lg font-semibold leading-snug">{s.t}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft">{s.d}</p>
          </li>
        ))}
      </ol>
      <p class="mt-7 text-[15px] leading-relaxed text-ink-soft max-w-[720px]">Koľko správa stojí a ako sa líši od garantovaného nájmu, nájdete v <a href="/cennik" class="font-bold text-accent-deep underline">cenníku</a>. Ak chcete radšej rovnakú sumu každý mesiac, pozrite si <a href="/garantovany-prenajom" class="font-bold text-accent-deep underline">garantovaný prenájom</a>. Ako sa našim bytom darí, ukazujú <a href="/vysledky" class="font-bold text-accent-deep underline">hodnotenia hostí</a>.</p>
    </div>
  </section>

  <section class="wrap py-14 lg:py-16">
    <p class="eyebrow">Otázky</p>
    <h2 class="mt-2 text-[30px] md:text-[36px] font-bold tracking-[-0.02em] leading-[1.15]">Na čo sa majitelia pýtajú pri správe bytu</h2>
    <div class="grid md:grid-cols-2 gap-5 mt-7">
      {faq.map((f) => (
        <div class="p-6 bg-surface rounded-[var(--radius-card)]"><h3 class="text-lg font-semibold">{f.q}</h3><p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{f.a}</p></div>
      ))}
    </div>
  </section>

  <section class="bg-surface py-14 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Začíname</p>
      <h2 class="mt-2 text-[30px] md:text-[34px] font-bold tracking-[-0.02em] leading-[1.15]">Čo potrebujeme od vás</h2>
      <div class="grid md:grid-cols-3 gap-5 mt-7">
        <div class="p-6 bg-bg rounded-[var(--radius-card)]"><h3 class="text-lg font-semibold">Byt</h3><p class="mt-2 text-sm leading-relaxed text-ink-soft">Zariadený a pripravený na hostí. Ak nie je, na prvom stretnutí povieme, čo doplniť.</p></div>
        <div class="p-6 bg-bg rounded-[var(--radius-card)]"><h3 class="text-lg font-semibold">Kľúče a prístup</h3><p class="mt-2 text-sm leading-relaxed text-ink-soft">Kľúče od bytu a vchodu. O spôsobe odovzdávania hosťom sa dohodneme podľa bytu.</p></div>
        <div class="p-6 bg-bg rounded-[var(--radius-card)]"><h3 class="text-lg font-semibold">Zmluva</h3><p class="mt-2 text-sm leading-relaxed text-ink-soft">Zmluva o správe bytu alebo nájomná zmluva pri garantovanom nájme. Podmienky prejdeme spolu na stretnutí.</p></div>
      </div>
      <p class="mt-7 text-[15px] leading-relaxed text-ink-soft max-w-[720px]">Ak krátkodobý prenájom ešte len zvažujete, prečítajte si náš článok <a href="/blog/kratkodoby-prenajom-bytu-bratislava" class="font-bold text-accent-deep underline">Krátkodobý prenájom bytu v Bratislave: ako to funguje</a>.</p>
    </div>
  </section>

  <Cta text="Chcete vedieť, koľko by váš byt zarobil?" />
</Base>
