---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Check from '../components/Check.astro';

// Správa bytu za 10 % (model A). Texty služieb, postup a otázky sú z docs/fakty.md, docs/texty.md a cenníka, nič navyše.
// Upratovanie pri správe (odpoveď klienta 13. 10.): zabezpečujeme ho my, hosť pri rezervácii platí poplatok za upratovanie, zúčtuje sa vo vyúčtovaní.

// Ilustračný rok: výnos z krátkodobého prenájmu podľa mesiacov (ako v cenníku) a dlhodobý nájom ako čiara.
// Priemer stĺpcov je asi o polovicu vyšší ako čiara, čo zodpovedá schválenému „o 40 až 60 % vyšší“.
const months = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
const season = [52, 48, 60, 72, 84, 94, 100, 100, 86, 68, 54, 70];
const barColor = (h: number) => (h >= 100 ? 'var(--color-accent)' : h >= 84 ? 'var(--color-sand-deep)' : 'var(--color-sand)');
const longTerm = 50;

const steps = [
  { t: 'Stretnutie v byte', d: 'Prídeme sa na byt pozrieť a pripravíme odhad výnosu. Zadarmo a nezáväzne.' },
  { t: 'Zmluva', d: 'Podpíšeme zmluvu o správe bytu. Podmienky prejdeme spolu, výpovedná lehota je 30 dní.' },
  { t: 'Fotky, inzeráty a ceny', d: 'Byt nafotíme, napíšeme texty v slovenčine aj angličtine, založíme profily na Airbnb a Booking a nastavíme ceny podľa sezóny.' },
  { t: 'Prvý hosť', d: 'Zvyčajne 2 dni až týždeň od podpisu zmluvy.' },
  { t: 'Každý pobyt', d: 'Odpovedáme na správy a posielame pokyny k príchodu. Kľúče sú v schránke na kľúče alebo v boxe. Počas pobytu riešime všetko, čo hosť potrebuje.' },
  { t: 'Po odchode hosťa', d: 'Byt upraceme, vymeníme posteľnú bielizeň a uteráky, doplníme, čo chýba, a skontrolujeme jeho stav. Postaráme sa aj o recenzie.' },
  { t: 'Koniec mesiaca', d: 'Dostanete prehľad príjmov, rezervácií a obsadenosti. Peniaze prídu do 10. dňa nasledujúceho mesiaca.' },
];
const phases = [
  { label: 'Začiatok', note: 'prvý týždeň', items: steps.slice(0, 4), from: 1 },
  { label: 'Potom', note: 'každý pobyt a každý mesiac', items: steps.slice(4), from: 5 },
];
// Otázky majiteľov k správe bytu: na stránke aj v štruktúrovaných dátach (FAQPage)
const faq = [
  { q: 'Kto platí upratovanie?', a: 'Upratovanie po každom pobyte zabezpečujeme my. Hosť pri rezervácii platí poplatok za upratovanie a v mesačnom vyúčtovaní uvidíte, ako sa zúčtovalo.' },
  { q: 'Kto platí opravy?', a: 'Menšie opravy hradíme my. Pri väčších opravách záleží na tom, čím a ako vznikli.' },
  { q: 'Čo ak hosť niečo poškodí?', a: 'Škody nie sú také časté, ako si ľudia myslia, ale stávajú sa. Väčšinou ich vyriešime sami tak, že to vy riešiť nemusíte.' },
  { q: 'Kto platí energie a internet?', a: 'Pri správe bytu energie, internet, spotrebný materiál a poplatky platforiem hradí majiteľ. Menšie opravy hradíme my.' },
  { q: 'Ako rýchlo príde prvý hosť?', a: 'Zvyčajne 2 dni až týždeň od podpisu zmluvy.' },
  { q: 'Môžem byt používať aj ja?', a: 'Áno. Ako často a s akým predstihom si ho zablokujete, dohodneme prípad od prípadu.' },
  { q: 'Na ktorých platformách byt inzerujete?', a: 'Na Airbnb a Booking, podľa bytu aj na ďalších platformách.' },
];
const star = 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z';
---
<Base title="Správa bytu na Airbnb a Booking za 10 %" breadcrumb="Správa bytu" faq={faq} service={{ name: 'Správa bytu na Airbnb a Booking', serviceType: 'Správa krátkodobého prenájmu', description: 'Fotenie, inzeráty a ceny, komunikácia s hosťami, upratovanie, údržba a mesačné vyúčtovanie bytu na krátkodobý prenájom v Bratislave za 10 % z obratu.' }} description="Čo robí správca Airbnb: fotenie, inzeráty a ceny, komunikácia s hosťami, upratovanie, údržba a mesačné vyúčtovanie. Správa bytu v Bratislave za 10 %.">
  <!-- Hero: hlavný prínos vľavo, motív „byt + dôkaz“ vpravo (naklonená fotka s kartou 10 %) -->
  <section class="wrap grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-14 pt-10 pb-14 lg:pt-14 lg:pb-20 items-center">
    <div class="flex flex-col gap-6">
      <h1 class="chip self-start">Správa bytu na Airbnb a Booking v Bratislave</h1>
      <p class="display text-[40px] sm:text-[50px] lg:text-[58px] leading-[1.05] font-bold tracking-[-0.025em] text-pretty">Od prvej fotky po <span class="text-accent">posledné upratovanie.</span></p>
      <p class="text-lg leading-relaxed text-ink-soft max-w-[560px]">Päť vecí, ktoré by ste pri krátkodobom prenájme riešili každý týždeň, od fotenia po vyúčtovanie. Preberáme ich všetky, pri správe bytu aj pri <a href="/garantovany-prenajom" class="font-bold text-accent-deep underline">garantovanom nájme</a>.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/kontakt" class="btn-primary">Chcem odhad výnosu</a>
        <span class="text-sm text-ink-soft">Zadarmo a nezáväzne.<br class="hidden sm:block" /> Prídeme sa na byt pozrieť.</span>
      </div>
      <p class="flex items-center gap-3 pt-5 border-t border-sand text-sm leading-relaxed text-ink-soft">
        <span class="w-9 h-9 rounded-full bg-sage text-white inline-flex items-center justify-center shrink-0" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d={star}></path></svg></span>
        <span><b class="text-ink">4,89 z 5 na Airbnb · Superhost</b> · Booking 9,6 z 10<br />804 hodnotení hostí, verejné a overiteľné</span>
      </p>
    </div>
    <div class="relative h-[420px] sm:h-[480px] lg:h-[520px]">
      <div class="absolute top-0 right-0 w-[88%] h-[82%] rounded-[var(--radius-block)] overflow-hidden rotate-2 shadow-[var(--shadow-float)]">
        <img src="/img/byt-metropolis.avif" alt="Byt Metropolis na Nivách, ktorý spravujeme na Airbnb a Booking" class="w-full h-full object-cover" width="1440" height="1080" fetchpriority="high" decoding="async" />
      </div>
      <span class="absolute top-6 right-4 sm:right-6 px-3.5 py-2 bg-white/95 rounded-full text-[13px] font-bold text-ink shadow-[var(--shadow-float)]">Airbnb a Booking</span>
      <div class="absolute left-0 bottom-0 w-[min(330px,88%)] flex flex-col gap-2 p-6 bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-float)]">
        <div class="flex items-baseline gap-2"><span class="display text-[64px] leading-[0.9] font-bold tracking-[-0.04em] text-accent">10 %</span><span class="display text-lg font-semibold">z obratu</span></div>
        <span class="text-[14px] leading-snug text-ink-soft">Z príjmov z pobytov si berieme desatinu. Keď byt nezarába, nezarábame ani my.</span>
      </div>
    </div>
  </section>

  <!-- Ukotvenie výnosu: jediný pohyb na stránke (stĺpce narastú, čiara dlhodobého nájmu sa dokreslí) -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="wrap grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-center">
      <div class="flex flex-col gap-5">
        <p class="eyebrow">Výnos</p>
        <h2 class="text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] text-pretty">Potenciálny výnos o 40 až 60 % vyšší ako pri dlhodobom nájme</h2>
        <p class="text-[17px] leading-relaxed text-ink-soft">Závisí od lokality, veľkosti a sezóny. V sezóne býva byt obsadený okolo 95 % nocí, mimo nej 60 až 70 %.</p>
        <ul class="flex flex-col gap-2.5 text-[15px]">
          <li class="flex items-center gap-3"><span class="w-6 h-3 rounded-[3px] bg-sand-deep shrink-0" aria-hidden="true"></span>Výnos z krátkodobého prenájmu podľa mesiaca</li>
          <li class="flex items-center gap-3"><span class="w-6 border-t-[3px] border-dashed border-ink-muted shrink-0" aria-hidden="true"></span>Rovnaký byt prenajatý dlhodobo</li>
        </ul>
        <p class="text-[15px] leading-relaxed text-ink-soft">Chcete radšej rovnakú sumu každý mesiac? Pozrite si <a href="/garantovany-prenajom" class="font-bold text-accent-deep underline">garantovaný prenájom</a>.</p>
      </div>
      <figure class="flex flex-col gap-5 p-6 md:p-9 bg-bg rounded-[var(--radius-block)]" data-chart>
        <div class="flex items-center justify-between gap-3">
          <span class="display text-lg font-bold">Jeden rok prenájmu</span>
          <span class="chip !bg-surface !py-1 !px-2.5 text-[12px]">ilustračný príklad</span>
        </div>
        <div class="relative h-[220px] md:h-[260px]">
          <div class="absolute inset-0 flex items-end gap-1.5 md:gap-2" aria-hidden="true">
            {season.map((h, i) => <span class="bar flex-1 rounded-t-[6px]" style={`height:${h}%;background:${barColor(h)};--i:${i}`}></span>)}
          </div>
          <div class="rent-line absolute inset-x-0 flex items-center" style={`bottom:${longTerm}%`} aria-hidden="true">
            <span class="flex-1 border-t-[3px] border-dashed border-ink-muted"></span>
            <span class="absolute right-0 bottom-[calc(100%+6px)] px-2.5 py-1 rounded-full bg-surface text-ink-soft text-[12px] font-bold whitespace-nowrap">dlhodobý nájom</span>
          </div>
        </div>
        <div class="flex gap-1.5 md:gap-2 -mt-2 text-[11px] font-bold text-ink-muted text-center" aria-hidden="true">{months.map((m) => <span class="flex-1">{m}</span>)}</div>
        <figcaption class="text-[13px] leading-relaxed text-ink-soft">Stĺpce ukazujú, ako sa výnos z krátkodobého prenájmu mení počas roka. Prerušovaná čiara je ten istý byt prenajatý dlhodobo. Ilustračný príklad, nie skutočné čísla.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Služby: rôznorodá mriežka, jedna dominantná dlaždica (komunikácia s hosťami je to, čo majiteľov najviac zaťažuje) -->
  <section class="wrap py-16 lg:py-24">
    <p class="eyebrow">Služby</p>
    <h2 class="mt-2 text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] max-w-[760px] text-pretty">Čo všetko za vás robíme</h2>
    <div class="grid lg:grid-cols-3 lg:grid-rows-[auto_auto] gap-5 mt-10">
      <article class="lg:row-span-2 flex flex-col gap-5 p-7 md:p-9 bg-surface rounded-[var(--radius-block)]">
        <img src="/img/ilu-hostia.svg" alt="Ilustrácia: telefón so správami a kľúč" class="w-full aspect-[3/2] object-cover rounded-[var(--radius-card)] bg-sand" width="600" height="400" loading="lazy" />
        <h3 class="text-[26px] font-bold leading-tight">Hostia a komunikácia</h3>
        <p class="display text-[24px] md:text-[28px] leading-[1.25] font-semibold">Od prvej správy po odhlásenie. Hostia píšu nám, nie vám. <span class="text-accent">Aj v sobotu o desiatej večer.</span></p>
        <ul class="flex flex-col gap-2.5 mt-auto"><Check>Odpovede na dopyty a rezervácie</Check><Check>Check-in, check-out, inštrukcie k bytu</Check><Check>Riešenie problémov počas pobytu a recenzie</Check></ul>
      </article>
      <article class="flex flex-col gap-4 p-7 bg-surface rounded-[var(--radius-block)]">
        <h3 class="text-xl font-bold leading-snug">Fotenie, inzeráty a ceny</h3>
        <p class="text-[15px] leading-relaxed text-ink-soft">Byt profesionálne nafotíme, napíšeme texty v slovenčine aj angličtine a založíme profily na Airbnb a Booking. Ceny sledujeme priebežne podľa sezóny, dopytu a obsadenosti.</p>
        <ul class="flex flex-col gap-2 mt-auto"><Check>Profesionálne fotenie a texty SK / EN</Check><Check>Profily na Airbnb, Booking a ďalších platformách</Check></ul>
      </article>
      <article class="flex flex-col gap-4 p-7 bg-sage-soft rounded-[var(--radius-block)]">
        <h3 class="text-xl font-bold leading-snug">Upratovanie a bielizeň</h3>
        <p class="text-[15px] leading-relaxed text-ink-soft">Po každom odchode hostí byt upraceme, vymeníme posteľnú bielizeň a uteráky a doplníme, čo chýba. Zároveň skontrolujeme, či je všetko v poriadku.</p>
        <ul class="flex flex-col gap-2 mt-auto"><Check>Upratovanie po každom pobyte</Check><Check>Kontrola stavu bytu po hosťoch</Check></ul>
      </article>
      <article class="lg:col-span-2 grid sm:grid-cols-[1fr_0.8fr] gap-6 items-center p-7 bg-surface rounded-[var(--radius-block)]">
        <div class="flex flex-col gap-4">
          <h3 class="text-xl font-bold leading-snug">Údržba a starostlivosť o byt</h3>
          <p class="text-[15px] leading-relaxed text-ink-soft">Kvapkajúci kohútik, zaseknutý zámok, vypálená žiarovka. Riešime ich hneď, keď to zbadáme, nie až po vašom telefonáte.</p>
          <ul class="flex flex-col gap-2"><Check>Drobné opravy</Check><Check>Koordinácia remeselníkov pri väčších poruchách</Check><Check>Pravidelná kontrola bytu</Check></ul>
        </div>
        <img src="/img/ilu-udrzba.svg" alt="Ilustrácia: kohútik, kľúč a checklist" class="w-full aspect-[3/2] object-cover rounded-[var(--radius-card)] bg-sand" width="600" height="400" loading="lazy" />
      </article>
    </div>
  </section>

  <!-- Vyúčtovanie: doklad ako dôkaz transparentnosti, naklonený ako fotky v hlavičke -->
  <section class="bg-sand py-16 lg:py-24">
    <div class="wrap grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="flex flex-col gap-5">
        <p class="eyebrow">Vyúčtovanie</p>
        <h2 class="text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] text-pretty">Každý mesiac čierne na bielom</h2>
        <p class="text-[17px] leading-relaxed text-ink-soft">Dostanete prehľad: príjmy z pobytov, naša odmena 10 % a suma, ktorá ide vám.</p>
        <ul class="flex flex-col gap-2.5"><Check>Prehľad príjmov a rezervácií za mesiac</Check><Check>Prehľad obsadenosti bytu</Check><Check>Peniaze do 10. dňa nasledujúceho mesiaca</Check></ul>
      </div>
      <div class="relative py-6">
        <div class="flex flex-col gap-3 p-7 md:p-8 bg-surface rounded-[var(--radius-block)] -rotate-2 shadow-[var(--shadow-float)] max-w-[440px] md:ml-auto">
          <div class="flex justify-between items-center gap-3">
            <span class="text-[13px] font-bold text-ink-muted">Ukážka vyúčtovania · správa bytu</span>
            <span class="chip !py-1 !px-2.5 text-[12px] whitespace-nowrap">ilustračný príklad</span>
          </div>
          <div class="flex justify-between gap-4 py-2.5 border-b border-sand text-[15px]"><span>Príjmy z pobytov</span><b class="whitespace-nowrap">2 000 €</b></div>
          <div class="flex justify-between gap-4 py-2.5 border-b border-sand text-[15px]"><span>Odmena Rental Partners (10 %)</span><b class="whitespace-nowrap">− 200 €</b></div>
          <div class="flex justify-between gap-4 py-3 text-[17px]"><b>Zostáva vám</b><b class="display text-[28px] leading-none text-sage whitespace-nowrap">1 800 €</b></div>
          <p class="text-[12px] leading-relaxed text-ink-muted">Pri garantovanom nájme vyúčtovanie odpadá, dostávate dohodnutú sumu.</p>
        </div>
        <span class="absolute -bottom-1 left-4 md:left-auto md:right-[300px] inline-flex items-center gap-2 px-3.5 py-2 bg-sage text-white rounded-full text-[13px] font-bold shadow-[var(--shadow-float)]">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
          na účte do 10. dňa
        </span>
      </div>
    </div>
  </section>

  <!-- Postup v dvoch fázach: začiatok a opakujúci sa cyklus -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="wrap">
      <p class="eyebrow">Postup</p>
      <h2 class="mt-2 text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1]">Ako správa bytu funguje v praxi</h2>
      <div class="flex flex-col gap-14 mt-12">
        {phases.map((p) => (
          <div>
            <p class="flex items-baseline gap-3 mb-7"><span class="display text-2xl font-bold">{p.label}</span><span class="text-[15px] text-ink-muted">{p.note}</span></p>
            <div class="relative">
              <span class="hidden lg:block absolute top-[22px] left-[22px] right-[12%] h-[2px] bg-sand" aria-hidden="true"></span>
              <ol class:list={['relative grid sm:grid-cols-2 gap-8 lg:gap-6', p.items.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']} start={p.from}>
                {p.items.map((s, i) => (
                  <li class="flex flex-col gap-3">
                    <span class:list={['display w-11 h-11 rounded-full text-[15px] font-semibold flex items-center justify-center', p.from + i === steps.length ? 'bg-accent text-white' : 'bg-ink text-bg']} aria-hidden="true">{p.from + i}</span>
                    <h3 class="text-lg font-semibold leading-snug">{s.t}</h3>
                    <p class="text-[15px] leading-relaxed text-ink-soft max-w-[300px]">{s.d}</p>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-12 text-[15px] leading-relaxed text-ink-soft max-w-[720px]">Koľko správa stojí a ako sa líši od garantovaného nájmu, nájdete v <a href="/cennik" class="font-bold text-accent-deep underline">cenníku</a>.</p>
    </div>
  </section>

  <!-- Sociálny dôkaz: skutočné recenzie a verejné hodnotenia -->
  <section class="wrap py-16 lg:py-24">
    <p class="eyebrow">Výsledky</p>
    <h2 class="mt-2 text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] max-w-[760px] text-pretty">Čo o bytoch, ktoré spravujeme, píšu hostia</h2>
    <div class="grid lg:grid-cols-[1fr_1fr_0.75fr] gap-5 mt-10">
      <blockquote class="flex flex-col gap-4 p-7 md:p-8 bg-surface rounded-[var(--radius-block)]">
        <div class="flex gap-[3px] text-sage" role="img" aria-label="5 z 5 hviezdičiek">{[1, 2, 3, 4, 5].map(() => <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d={star}></path></svg>)}</div>
        <p class="display text-xl leading-[1.4] italic">„Bolo to perfektné! Skvelá poloha, niečo vyše 5 minút chôdze od centra, ale napriek tomu naozaj pokojné. Tomas bol veľmi nápomocný a vždy odpovedal okamžite.“</p>
        <footer class="mt-auto text-sm text-ink-soft">Karl, Brunoy (Francúzsko) · Airbnb · júl 2026</footer>
      </blockquote>
      <blockquote class="flex flex-col gap-4 p-7 md:p-8 bg-surface rounded-[var(--radius-block)]">
        <div class="flex gap-[3px] text-sage" role="img" aria-label="5 z 5 hviezdičiek">{[1, 2, 3, 4, 5].map(() => <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d={star}></path></svg>)}</div>
        <p class="display text-xl leading-[1.4] italic">„Komunikácia s Amandou bola vždy priateľská a rýchla. Pokyny k ubytovaniu a k používaniu podzemného parkoviska boli dokonalé a ľahko pochopiteľné.“</p>
        <footer class="mt-auto text-sm text-ink-soft">Jens, Aßlar (Nemecko) · Airbnb · júl 2026</footer>
      </blockquote>
      <div class="flex flex-col justify-between gap-6 p-7 md:p-8 bg-sage-soft rounded-[var(--radius-block)]">
        <div class="flex flex-col gap-1"><span class="display text-[44px] leading-none font-bold">4,89</span><span class="text-sm text-ink-soft">z 5 na Airbnb · Superhost · 109 recenzií</span></div>
        <div class="flex flex-col gap-1"><span class="display text-[44px] leading-none font-bold">9,6</span><span class="text-sm text-ink-soft">z 10 na Bookingu · 695 hodnotení</span></div>
        <a href="/vysledky" class="link-inline self-start">Všetky hodnotenia →</a>
      </div>
    </div>
  </section>

  <!-- Otázky ako rozbaľovací zoznam -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="wrap grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
      <div class="flex flex-col gap-4 lg:sticky lg:top-8 self-start">
        <p class="eyebrow">Otázky</p>
        <h2 class="text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] text-pretty">Na čo sa majitelia pýtajú pri správe bytu</h2>
        <p class="text-[15px] leading-relaxed text-ink-soft">Odpoveď ste nenašli? Zavolajte Tomášovi na <a href="tel:+421903989040" class="font-bold text-ink whitespace-nowrap">+421 903 989 040</a>.</p>
      </div>
