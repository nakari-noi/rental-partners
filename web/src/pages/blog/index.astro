---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog o krátkodobom prenájme bytu v Bratislave" breadcrumb="Blog" description="Rady pre majiteľov bytov v Bratislave: krátkodobý prenájom cez Airbnb a Booking, výnosy, povinnosti a spolupráca so správcom. Píšeme o tom, čo robíme denne.">
  <section class="wrap pt-10 pb-8 lg:pt-14">
    <span class="chip">Blog</span>
    <h1 class="mt-5 text-[38px] md:text-[52px] leading-[1.08] font-bold tracking-[-0.02em] max-w-[820px] text-pretty">Rady pre majiteľov bytov v Bratislave</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft max-w-[640px]">Píšeme o tom, čo robíme každý deň: krátkodobý prenájom cez Airbnb a Booking, výnosy, povinnosti majiteľa a spolupráca so správcom. Bez strašenia a bez sľubov o rýchlom zbohatnutí.</p>
  </section>

  <section class="bg-surface py-14 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Články</p>
      <div class="grid md:grid-cols-2 gap-6 mt-6">
        {posts.map((p, i) => (
          <a href={`/blog/${p.id}`} class:list={['group flex flex-col gap-4 p-7 lg:p-9 bg-bg rounded-[var(--radius-block)] transition-transform duration-300 hover:-translate-y-1', i === 0 && 'md:col-span-2']}>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-bold text-ink-muted">
              <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
              {p.data.readingMinutes && <span>· {p.data.readingMinutes} min čítania</span>}
            </p>
            <h2 class:list={['font-bold tracking-[-0.02em] leading-[1.15] text-pretty', i === 0 ? 'text-[28px] md:text-[36px] max-w-[760px]' : 'text-[22px] md:text-[24px]']}>{p.data.title}</h2>
            <p class="text-[16px] leading-relaxed text-ink-soft max-w-[680px]">{p.data.perex ?? p.data.description}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 py-1 text-sm font-bold text-accent">Čítať článok <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta text="Chcete vedieť, koľko by váš byt zarobil?" />
</Base>
